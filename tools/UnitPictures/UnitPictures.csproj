<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reads each unit's picture and in-game name out of an installed copy of WARNO, and saves them in one zip:
    a test of what the Units tab will do, and the pictures for its mock. Run on a PC with the game installed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Zstandard, which the game's textures are compressed with (MIT) -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>

</Project>
