<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- this library's English texts, such as the file list's Status column (see Languages\DataTexts.cs) -->
    <EmbeddedResource Include="Languages\en\*.json" LogicalName="EasyNdf.Data.Languages.en.%(Filename)%(Extension)" />
    <ProjectReference Include="..\EasyNdf.Engine\EasyNdf.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- unpacks the games' textures and atlases, which are compressed with Zstandard (MIT; its notice is in THIRD-PARTY-NOTICES.txt) -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>

</Project>
