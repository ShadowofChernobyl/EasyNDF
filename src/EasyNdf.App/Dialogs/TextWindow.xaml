<!--
  A window that shows a long text to read (the HTML app's #licDlg, and #logDlg for the change log): its title and ×, then
  the text in a sunken box that scrolls. It is 46rem wide and 88% of the window's height, at most 60rem.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.TextWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             Visibility="Collapsed" KeyDown="KeyPressed">
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed" SizeChanged="BackdropResized">
        <controls:Bevel x:Name="Box" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="12,10,12,12" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Common.TextWindow.CloseEscape.Tip}" Click="CloseClicked" />
                    <TextBlock x:Name="Title" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" />
                </DockPanel>
                <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True"
                                  FocusVisualStyle="{x:Null}">
                        <ContentControl x:Name="TextHolder" Margin="12,8" Focusable="False" />
                    </ScrollViewer>
                </controls:Bevel>
            </DockPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
