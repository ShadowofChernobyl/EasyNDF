<!--
  The Filter Descriptors window (the HTML app's #dfPop): conditions on the descriptors' properties that the descriptor
  viewer's tree keeps to, saved filters, and import and export of them. Every change is used at once.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.FilterWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             Visibility="Collapsed" KeyDown="KeyPressed">
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed" SizeChanged="BackdropResized">
        <!-- .box.raised: 40rem wide at most, 94% of the app; at most 90% of it tall; 10 pixels in at the top and 12 elsewhere, its parts 6 pixels apart -->
        <controls:Bevel x:Name="Box" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="12,10,12,12" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <!-- .bar: the title, then ? and × -->
                    <DockPanel>
                        <controls:SnappedRow DockPanel.Dock="Right" Gap="4">
                            <Button Style="{StaticResource HelpButton}" ToolTip="About the descriptor filter" controls:QuickHelp.Page="editor-desc" />
                            <Button Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="Close (Escape)" Click="CloseClicked" />
                        </controls:SnappedRow>
                        <TextBlock Text="Filter Descriptors" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- .dfpre: the saved filters -->
                    <DockPanel Margin="0,6,0,0">
                        <controls:SnappedRow DockPanel.Dock="Right" Gap="4">
                            <Button Content="Import..." ToolTip="Add the filters of a filter file" Click="ImportClicked" />
                            <Button x:Name="ExportButton" Content="Export" ToolTip="Save the saved filters (or this one) as a file" Click="ExportClicked" />
                        </controls:SnappedRow>
                        <controls:SnappedRow Gap="4">
                            <TextBlock Text="Saved filter" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SavedChoice" MinWidth="144" ToolTip="Use a saved filter" SelectionChanged="SavedChosen" />
                            <Button x:Name="SaveButton" Content="Save" ToolTip="Save the conditions under this filter's name" Click="SaveClicked" />
                            <Button Content="Save as..." ToolTip="Save the conditions under a new name" Click="SaveAsClicked" />
                            <Button x:Name="DeleteButton" Content="Delete" ToolTip="Delete this saved filter" Click="DeleteClicked" />
                        </controls:SnappedRow>
                    </DockPanel>

                    <!-- .dfgate: all or any -->
                    <controls:SnappedRow Gap="4" Margin="0,6,0,0">
                        <TextBlock Text="Show descriptors where" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                        <!-- .bar select: 11rem at least -->
                        <ComboBox x:Name="GateChoice" MinWidth="176" ToolTip="Whether every condition must match, or one is enough" SelectionChanged="GateChosen">
                            <ComboBoxItem Content="all" Tag="All" />
                            <ComboBoxItem Content="any" Tag="Any" />
                        </ComboBox>
                        <TextBlock Text="of these match:" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                    </controls:SnappedRow>

                    <!-- #dfList: the conditions, from 3.2rem to 14rem tall -->
                    <controls:Bevel Margin="0,6,0,0" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                        <ScrollViewer MinHeight="49" MaxHeight="222" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="RuleList" Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent"
                                        PreviewKeyDown="ListKeyDown" MouseLeftButtonDown="ListPressed" MouseRightButtonUp="ListRightClicked" />
                        </ScrollViewer>
                    </controls:Bevel>

                    <!-- #dfEdit: the chosen condition, label beside box; dimmed while there is none -->
                    <controls:Bevel x:Name="EditBox" Margin="0,6,0,0" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Name" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Tag="Optional. Shown in the list" ToolTip="A name for the condition, shown in the list" TextChanged="NameTyped" />
                            <TextBlock Grid.Row="1" Text="Property" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <ComboBox x:Name="PropertyChoice" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" FontFamily="{DynamicResource mono}" FontSize="12"
                                      ToolTip="The property to test" SelectionChanged="PropertyChosen" />
                            <TextBlock Grid.Row="2" Text="Test" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <ComboBox x:Name="TestChoice" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" ToolTip="How to test it" SelectionChanged="TestChosen" />
                            <TextBlock Grid.Row="3" Text="Value" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ValueBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource MonoBox}" ToolTip="What to test against. Quotes and capitals do not matter" TextChanged="ValueTyped" />
                        </Grid>
                    </controls:Bevel>

                    <!-- .bar: Add condition, and how many descriptors are shown -->
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Left" Content="Add condition" ToolTip="Add a condition" Click="AddClicked" />
                        <TextBlock x:Name="CountNote" Style="{StaticResource Note}" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- .bar: Clear filter, and Done -->
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GoButton}" Content="Done" ToolTip="Close. The filter stays on" Click="CloseClicked" />
                        <Button Content="Clear filter" HorizontalAlignment="Left" ToolTip="Take every condition away" Click="ClearClicked" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </controls:Bevel>
    </Grid>
</UserControl>
