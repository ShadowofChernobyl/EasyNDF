<!--
  The Filter Descriptors window (the HTML app's #dfPop): conditions on the descriptors' properties that the descriptor
  viewer's tree keeps to, saved filters, and import and export of them. Every change is used at once.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.FilterWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             Visibility="Collapsed" KeyDown="KeyPressed">
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed" SizeChanged="BackdropResized">
        <!-- .box.raised: 40rem wide at most, 94% of the app; at most 90% of it tall; 10 pixels in at the top and 12 elsewhere, its parts 6 pixels apart -->
        <controls:Bevel x:Name="Box" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="12,10,12,12" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <!-- .bar: the title, then ? and × -->
                    <DockPanel>
                        <controls:SnappedRow DockPanel.Dock="Right" Gap="4">
                            <Button Style="{StaticResource HelpButton}" ToolTip="{t:Text Editor.Filter.AboutTheDescriptorFilter.Tip}" controls:QuickHelp.Page="editor-desc" />
                            <Button Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Editor.Filter.CloseEscape.Tip}" Click="CloseClicked" />
                        </controls:SnappedRow>
                        <TextBlock Text="{t:Text Editor.Filter.FilterDescriptors}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- .dfpre: the saved filters -->
                    <DockPanel Margin="0,6,0,0">
                        <controls:SnappedRow DockPanel.Dock="Right" Gap="4">
                            <Button Content="{t:Text Editor.Filter.Import}" ToolTip="{t:Text Editor.Filter.Import.Tip}" Click="ImportClicked" />
                            <Button x:Name="ExportButton" Content="{t:Text Editor.Filter.Export}" ToolTip="{t:Text Editor.Filter.Export.Tip}" Click="ExportClicked" />
                        </controls:SnappedRow>
                        <controls:SnappedRow Gap="4">
                            <TextBlock Text="{t:Text Editor.Filter.SavedFilter}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SavedChoice" MinWidth="144" ToolTip="{t:Text Editor.Filter.SavedChoice.Tip}" SelectionChanged="SavedChosen" />
                            <Button x:Name="SaveButton" Content="{t:Text Editor.Filter.Save}" ToolTip="{t:Text Editor.Filter.Save.Tip}" Click="SaveClicked" />
                            <Button Content="{t:Text Editor.Filter.SaveAs}" ToolTip="{t:Text Editor.Filter.SaveAs.Tip}" Click="SaveAsClicked" />
                            <Button x:Name="DeleteButton" Content="{t:Text Editor.Filter.Delete}" ToolTip="{t:Text Editor.Filter.Delete.Tip}" Click="DeleteClicked" />
                        </controls:SnappedRow>
                    </DockPanel>

                    <!-- .dfgate: all or any -->
                    <controls:SnappedRow Gap="4" Margin="0,6,0,0">
                        <TextBlock Text="{t:Text Editor.Filter.ShowDescriptorsWhere}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                        <!-- .bar select: 11rem at least -->
                        <ComboBox x:Name="GateChoice" MinWidth="176" ToolTip="{t:Text Editor.Filter.GateChoice.Tip}" SelectionChanged="GateChosen">
                            <ComboBoxItem Content="{t:Text Editor.Filter.All}" Tag="All" />
                            <ComboBoxItem Content="{t:Text Editor.Filter.Any}" Tag="Any" />
                        </ComboBox>
                        <TextBlock Text="{t:Text Editor.Filter.OfTheseMatch}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                    </controls:SnappedRow>

                    <!-- #dfList: the conditions, from 3.2rem to 14rem tall -->
                    <controls:Bevel Margin="0,6,0,0" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                        <ScrollViewer MinHeight="49" MaxHeight="222" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="RuleList" Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent"
                                        PreviewKeyDown="ListKeyDown" MouseLeftButtonDown="ListPressed" MouseRightButtonUp="ListRightClicked" />
                        </ScrollViewer>
                    </controls:Bevel>

                    <!-- #dfEdit: the chosen condition, label beside box; dimmed while there is none -->
                    <controls:Bevel x:Name="EditBox" Margin="0,6,0,0" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{t:Text Editor.Filter.Name}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Tag="{t:Text Editor.Filter.NameBox.Hint}" ToolTip="{t:Text Editor.Filter.NameBox.Tip}" TextChanged="NameTyped" />
                            <TextBlock Grid.Row="1" Text="{t:Text Editor.Filter.Property}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <ComboBox x:Name="PropertyChoice" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" FontFamily="{DynamicResource mono}" FontSize="12"
                                      ToolTip="{t:Text Editor.Filter.PropertyChoice.Tip}" SelectionChanged="PropertyChosen" />
                            <TextBlock Grid.Row="2" Text="{t:Text Editor.Filter.Test}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <ComboBox x:Name="TestChoice" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" ToolTip="{t:Text Editor.Filter.TestChoice.Tip}" SelectionChanged="TestChosen" />
                            <TextBlock Grid.Row="3" Text="{t:Text Editor.Filter.Value}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ValueBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource MonoBox}" ToolTip="{t:Text Editor.Filter.ValueBox.Tip}" TextChanged="ValueTyped" />
                        </Grid>
                    </controls:Bevel>

                    <!-- .bar: Add condition, and how many descriptors are shown -->
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Left" Content="{t:Text Editor.Filter.AddCondition}" ToolTip="{t:Text Editor.Filter.AddCondition.Tip}" Click="AddClicked" />
                        <TextBlock x:Name="CountNote" Style="{StaticResource Note}" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- .bar: Clear filter, and Done -->
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GoButton}" Content="{t:Text Editor.Filter.Done}" ToolTip="{t:Text Editor.Filter.Done.Tip}" Click="CloseClicked" />
                        <Button Content="{t:Text Editor.Filter.ClearFilter}" HorizontalAlignment="Left" ToolTip="{t:Text Editor.Filter.ClearFilter.Tip}" Click="ClearClicked" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </controls:Bevel>
    </Grid>
</UserControl>
