<!--
  The Swap window, laid out as its mock (5): the weapons that can take the place of one mounted on a unit (or be added
  to a turret, or copied as a new weapon), in groups by whether they fit there: those that fit, those of another kind
  (which fire with the place's flash and sound), and those that may not work there, each saying why (they can be used
  after a warning). At the right, the
  weapon picked beside the one there now, and the buttons that use it as it is or as a copy. 900 by 560 pixels, or 96%
  of a smaller window, centred on the dimmed backdrop as the other windows.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.SwapWeaponWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:dialogs="clr-namespace:EasyNdf.App.Dialogs"
             Visibility="Collapsed" KeyDown="KeyPressed" Foreground="{DynamicResource ink}">
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed" SizeChanged="BackdropResized">
        <controls:Bevel x:Name="Box" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource bg}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel>
                <!-- the title, and the place dim beside it, with a line under them -->
                <controls:Bevel DockPanel.Dock="Top" BottomRight="{DynamicResource line}" Edges="0,0,0,1" Padding="10,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Common.TextWindow.CloseEscape.Tip}" Click="CancelClicked" />
                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <Run x:Name="TitleText" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource accent}" /><Run Text="    " /><Run x:Name="SubtitleText" FontSize="12" Foreground="{DynamicResource muted}" />
                        </TextBlock>
                    </DockPanel>
                </controls:Bevel>

                <!-- the foot: Cancel only, as the weapon is used with the buttons at the right -->
                <controls:Bevel DockPanel.Dock="Bottom" TopLeft="{DynamicResource line}" Edges="0,1,0,0" Padding="10,6">
                    <Button HorizontalAlignment="Right" Content="{t:Text Common.Cancel}" Click="CancelClicked" />
                </controls:Bevel>

                <DockPanel Margin="10,8,10,8">
                    <!-- the search, 260 wide, and only the open mod's own weapons -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox x:Name="SearchBox" Width="260" Tag="{t:Text Weapons.SearchBox.Hint}" ToolTip="{t:Text Weapons.SearchBox.Tip}" TextChanged="FilterChanged" />
                        <CheckBox x:Name="OnlyOwn" Style="{StaticResource Toggle}" Content="{t:Text Weapons.Swap.OnlyOwn}" ToolTip="{t:Text Weapons.Swap.OnlyOwn.Tip}"
                                  Margin="8,0,0,0" VerticalAlignment="Center" Click="FilterChanged" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                            <ListBox x:Name="ChoiceList" BorderThickness="0" Background="Transparent" SelectionChanged="ChoiceSelected" MouseDoubleClick="ChoiceDoubleClicked"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <!-- the row draws its own selection, as the mock's: the selection colour with a bar in the accent colour -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <!-- the theme's ink, not the system's black, which a list item would have otherwise -->
                                        <Setter Property="Foreground" Value="{DynamicResource ink}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <dialogs:SwapChoiceRow />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </controls:Bevel>

                        <!-- the weapon picked beside the one there now, and the buttons -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel>
                                <TextBlock x:Name="PickedTitle" FontWeight="Bold" Foreground="{DynamicResource accent}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <ContentControl x:Name="Comparison" Focusable="False" />
                                <TextBlock x:Name="BoxNote" FontSize="11.5" Foreground="{DynamicResource muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock x:Name="ReasonNote" FontSize="11.5" Foreground="{DynamicResource warn}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <StackPanel Margin="0,12,0,0">
                                    <Button x:Name="UseButton" Style="{StaticResource GoButton}" Content="{t:Text Weapons.Swap.Use}" ToolTip="{t:Text Weapons.Swap.Use.Tip}" Click="UseClicked" />
                                    <Button x:Name="UseCopyButton" Content="{t:Text Weapons.Swap.UseCopy}" ToolTip="{t:Text Weapons.Swap.UseCopy.Tip}" Margin="0,6,0,0" Click="UseCopyClicked" />
                                </StackPanel>
                                <TextBlock x:Name="CopyNote" FontSize="11.5" Foreground="{DynamicResource muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </DockPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
