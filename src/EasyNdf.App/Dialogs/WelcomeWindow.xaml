<!--
  The welcome window (the HTML app's #welcome): shown the first time the app starts, and again after Clear all data; the
  Help tab opens it too. 640 pixels wide, 16 pixels in at the top and bottom and 18 at the sides.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.WelcomeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             Visibility="Collapsed" KeyDown="KeyPressed">
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed">
        <controls:Bevel x:Name="Box" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="18,16" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <!-- the buttons always show; in a small app window the text above them scrolls -->
            <DockPanel>
                <!-- the note above keeps its 10 pixels, which win over the bar's 4 -->
                <DockPanel DockPanel.Dock="Bottom">
                    <controls:SnappedRow DockPanel.Dock="Right" Gap="6">
                        <Button x:Name="TourButton" Content="{t:Text Welcome.StartTheTutorial}" ToolTip="{t:Text Welcome.Tour.Tip}" Click="TourClicked" />
                        <Button x:Name="OkButton" Content="{t:Text Welcome.GetStarted}" Style="{StaticResource GoButton}" ToolTip="{t:Text Welcome.Ok.Tip}" Click="OkClicked" />
                    </controls:SnappedRow>
                    <TextBlock Style="{StaticResource Note}" Text="{t:Text Welcome.ThisWindowIsOn}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <controls:Bevel Style="{StaticResource Heading}" Margin="0,0,0,10">
                    <TextBlock Text="{t:Text Welcome.WelcomeToEasyNDF}" FontSize="15" LineHeight="21.75" LineStackingStrategy="BlockLineHeight" />
                </controls:Bevel>
                <!-- first, the language and the theme, each used as it is picked: the window itself changes -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{t:Text Settings.Language}" Foreground="{DynamicResource ink}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="LanguageChoice" Grid.Column="1" SelectionChanged="LanguageChosen" />
                    <TextBlock Grid.Column="3" Text="{t:Text Settings.Theme}" Foreground="{DynamicResource ink}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="ThemeChoice" Grid.Column="4" SelectionChanged="ThemeChosen" />
                </Grid>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ink}" Margin="0,0,0,10" t:RichText.Markup="{t:Text Welcome.Intro}" />
                <!--
                  The app's tabs in miniature, drawn in the theme: a note for each of the main tabs above it, joined by a
                  line to its tab (the lines are drawn in code, from where the notes and tabs fall in this theme and
                  language). Only to look at: nothing in it takes clicks or keys. No buttons under the tabs: they looked
                  like ones to click.
                -->
                <Grid x:Name="Map" Margin="0,2,0,12" IsHitTestVisible="False" Focusable="False" KeyboardNavigation.TabNavigation="None"
                      SizeChanged="MapResized">
                    <Grid.Resources>
                        <Style x:Key="MapNote" TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource line}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Background" Value="{DynamicResource well}" />
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="Margin" Value="5,0" />
                            <Setter Property="VerticalAlignment" Value="Bottom" />
                            <Setter Property="TextElement.FontFamily" Value="{DynamicResource mono}" />
                            <Setter Property="TextElement.FontSize" Value="11" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource accent}" />
                            <Style.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </Style.Resources>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <UniformGrid Rows="1" Columns="4">
                        <Border x:Name="FilesNote" Style="{StaticResource MapNote}"><TextBlock t:RichText.Markup="{t:Text Welcome.Map.Files}" /></Border>
                        <Border x:Name="ModsNote" Style="{StaticResource MapNote}"><TextBlock t:RichText.Markup="{t:Text Welcome.Map.Mods}" /></Border>
                        <Border x:Name="EditorNote" Style="{StaticResource MapNote}"><TextBlock t:RichText.Markup="{t:Text Welcome.Map.Editor}" /></Border>
                        <Border x:Name="ArmoryNote" Style="{StaticResource MapNote}"><TextBlock t:RichText.Markup="{t:Text Welcome.Map.Armory}" /></Border>
                    </UniformGrid>
                    <TabControl Grid.Row="2" Focusable="False">
                        <TabItem x:Name="FilesTab" Header="{t:Text Main.Files}" IsSelected="True" Focusable="False" />
                        <TabItem x:Name="ModsTab" Header="{t:Text Main.Rules}" Focusable="False" />
                        <TabItem x:Name="EditorTab" Header="{t:Text Main.Editor}" Focusable="False" />
                        <TabItem x:Name="ArmoryTab" Header="{t:Text Main.Units}" Focusable="False" />
                        <TabItem Header="{t:Text Main.Settings}" Focusable="False" />
                        <TabItem Header="{t:Text Main.Help}" Focusable="False" />
                    </TabControl>
                    <Canvas x:Name="Wires" Grid.RowSpan="3" />
                </Grid>
                <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10"
                           Text="{t:Text Welcome.YourFilesNeverLeave}" />
            </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
