<!--
  The welcome window (the HTML app's #welcome): shown the first time the app starts, and again after Clear all data; the
  Help tab opens it too. 34rem wide, 16 pixels in at the top and bottom and 18 at the sides.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.WelcomeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             Visibility="Collapsed" KeyDown="KeyPressed">
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed">
        <controls:Bevel TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="18,16" Width="544" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <StackPanel>
                <controls:Bevel Style="{StaticResource Heading}" Margin="0,0,0,10">
                    <TextBlock Text="{t:Text Welcome.WelcomeToEasyNDF}" FontSize="15" LineHeight="21.75" LineStackingStrategy="BlockLineHeight" />
                </controls:Bevel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ink}" Margin="0,0,0,10" t:RichText.Markup="{t:Text Welcome.Intro}" />
                <!-- the three steps, 22 pixels in, 4 pixels apart -->
                <Grid Margin="0,0,0,10" TextElement.Foreground="{DynamicResource ink}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="1." HorizontalAlignment="Right" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" t:RichText.Markup="{t:Text Welcome.Step1}" />
                    <TextBlock Grid.Row="2" Text="2." HorizontalAlignment="Right" Margin="0,0,4,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" t:RichText.Markup="{t:Text Welcome.Step2}" />
                    <TextBlock Grid.Row="4" Text="3." HorizontalAlignment="Right" Margin="0,0,4,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" t:RichText.Markup="{t:Text Welcome.Step3}" />
                </Grid>
                <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10"
                           Text="{t:Text Welcome.YourFilesNeverLeave}" />
                <!-- the note above keeps its 10 pixels, which win over the bar's 4 -->
                <DockPanel>
                    <controls:SnappedRow DockPanel.Dock="Right" Gap="6">
                        <Button x:Name="TourButton" Content="{t:Text Welcome.StartTheTutorial}" ToolTip="{t:Text Welcome.Tour.Tip}"
                                IsEnabled="False" />
                        <Button x:Name="OkButton" Content="{t:Text Welcome.GetStarted}" Style="{StaticResource GoButton}" ToolTip="{t:Text Welcome.Ok.Tip}" Click="OkClicked" />
                    </controls:SnappedRow>
                    <TextBlock Style="{StaticResource Note}" Text="{t:Text Welcome.ThisWindowIsOn}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
