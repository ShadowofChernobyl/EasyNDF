<!--
  The Armory's tab window: Edit Tab (a tab's label, its tooltip's three texts and, for a spare tab, the cost row its
  divisions get) and New Tab (the same, with the spare tab to bring in chosen first). Done keeps the values; Cancel,
  ×, Escape and a click beside the window close it without keeping them.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.TabWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             Visibility="Collapsed">
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed">
        <controls:Bevel x:Name="Box" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="12,10,12,12" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Units.Tabs.Close.Tip}" Click="CancelClicked"
                            AutomationProperties.Name="{t:Text Units.Tabs.Close.Tip}" />
                    <TextBlock x:Name="Title" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <controls:SnappedRow DockPanel.Dock="Bottom" Gap="6" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="DoneButton" Style="{StaticResource GoButton}" Click="DoneClicked" />
                    <Button Content="{t:Text Units.Tabs.Cancel}" Click="CancelClicked" />
                </controls:SnappedRow>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock x:Name="TabLabel" Foreground="{DynamicResource muted}" Margin="0,4,0,3" />
                        <!-- Edit Tab names the tab; New Tab chooses among the spare ones left -->
                        <TextBlock x:Name="TabName" FontFamily="{DynamicResource mono}" FontSize="12" />
                        <ComboBox x:Name="TabChoice" SelectionChanged="TabChosen" AutomationProperties.LabeledBy="{Binding ElementName=TabLabel}" />
                        <TextBlock x:Name="SpareNote" Style="{StaticResource Note}" Margin="0,6,0,0" Text="{t:Text Units.Tabs.New.Note}" />

                        <TextBlock x:Name="LabelLabel" Foreground="{DynamicResource muted}" Margin="0,7,0,3" />
                        <TextBox x:Name="LabelBox" ToolTip="{t:Text Units.Tabs.Field.Label.Tip}" AutomationProperties.LabeledBy="{Binding ElementName=LabelLabel}" />
                        <TextBlock x:Name="TitleLabel" Foreground="{DynamicResource muted}" Margin="0,7,0,3" />
                        <TextBox x:Name="TipTitleBox" ToolTip="{t:Text Units.Tabs.Field.Tip.Tip}" AutomationProperties.LabeledBy="{Binding ElementName=TitleLabel}" />
                        <TextBlock x:Name="TextLabel" Foreground="{DynamicResource muted}" Margin="0,7,0,3" />
                        <TextBox x:Name="TipTextBox" ToolTip="{t:Text Units.Tabs.Field.Tip.Tip}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="44" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.LabeledBy="{Binding ElementName=TextLabel}" />
                        <!-- drag to make the box above taller or shorter -->
                        <Thumb Tag="{Binding ElementName=TipTextBox}" Height="6" Cursor="SizeNS" DragStarted="GripGrabbed" DragDelta="GripDragged" ToolTip="{t:Text Units.Tabs.Grip.Tip}">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Border Background="Transparent">
                                        <Rectangle Width="28" Height="2" Fill="{DynamicResource line}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <TextBlock x:Name="MoreLabel" Foreground="{DynamicResource muted}" Margin="0,7,0,3" />
                        <TextBox x:Name="TipMoreBox" ToolTip="{t:Text Units.Tabs.Field.Tip.Tip}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="44" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.LabeledBy="{Binding ElementName=MoreLabel}" />
                        <!-- drag to make the box above taller or shorter -->
                        <Thumb Tag="{Binding ElementName=TipMoreBox}" Height="6" Cursor="SizeNS" DragStarted="GripGrabbed" DragDelta="GripDragged" ToolTip="{t:Text Units.Tabs.Grip.Tip}">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Border Background="Transparent">
                                        <Rectangle Width="28" Height="2" Fill="{DynamicResource line}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <StackPanel x:Name="SlotsPart">
                            <TextBlock x:Name="SlotsLabel" Foreground="{DynamicResource muted}" Margin="0,7,0,3" />
                            <TextBox x:Name="SlotsBox" FontFamily="{DynamicResource mono}" FontSize="12" ToolTip="{t:Text Units.Tabs.Field.Slots.Tip}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=SlotsLabel}" />
                            <TextBlock x:Name="SlotsNote" Style="{StaticResource Note}" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="Problem" Foreground="{DynamicResource caution}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="KeepNote" Style="{StaticResource Note}" Margin="0,6,0,0" Text="{t:Text Units.Tabs.Edit.KeepNote}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
