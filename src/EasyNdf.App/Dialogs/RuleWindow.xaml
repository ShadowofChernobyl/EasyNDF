<!--
  The rule window (the HTML app's #ruleDlg): the open rule's settings, centred over the dimmed app. What is inside the
  sunken body depends on the rule's type; Rules/RuleEditor.cs builds it. Done saves the changes; ×, Escape and a click
  outside throw them away, after asking.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.RuleWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             Visibility="Collapsed">
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed">
        <!-- .box.raised: 30rem wide (64rem for Add Descriptor), as tall as 92% of the app or 52rem; 10 pixels in at the top, 12 elsewhere -->
        <controls:Bevel x:Name="Box" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="12,10,12,12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed">
            <DockPanel>
                <!-- .bar: the title, then ? and × at the right -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <controls:SnappedRow DockPanel.Dock="Right" Gap="6">
                        <Button Style="{StaticResource HelpButton}" ToolTip="{t:Text Rules.RuleWindow.AboutRules.Tip}" controls:QuickHelp.Page="rules" />
                        <Button Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Rules.RuleWindow.CloseEscape.Tip}" Click="CancelClicked" />
                    </controls:SnappedRow>
                    <TextBlock x:Name="Title" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" Text="{t:Text Rules.RuleWindow.Rule}" />
                </DockPanel>

                <!-- #ruleFoot: the property scan, Done, and the notes under them -->
                <controls:FlexRow DockPanel.Dock="Bottom" Gap="8" LineGap="6" Margin="0,8,0,0">
                    <TextBlock Text="{t:Text Rules.RuleWindow.PropertyScan}" Foreground="{DynamicResource accent}" FontWeight="Bold" />
                    <!-- the dropdown takes the room left, up to 22rem -->
                    <ComboBox x:Name="ScanChoice" controls:FlexRow.Grow="1" MaxWidth="352" ToolTip="{t:Text Rules.RuleWindow.ScanChoice.Tip}" />
                    <Button Content="..." ToolTip="{t:Text Rules.RuleWindow.ScanAFileWithout.Tip}" Click="ScanFileClicked" />
                    <Button Style="{StaticResource GoButton}" Content="{t:Text Rules.RuleWindow.Done}" ToolTip="{t:Text Rules.RuleWindow.Done.Tip}" Click="DoneClicked" />
                    <TextBlock x:Name="ScanNote" Style="{StaticResource Note}" Margin="0" controls:FlexRow.Basis="Infinity" />
                    <TextBlock x:Name="RuleMessage" Style="{StaticResource Note}" Margin="0" controls:FlexRow.Basis="Infinity" />
                </controls:FlexRow>

                <!-- #ruleBody: sunken, in the panel colour, 10 by 12 pixels in; it scrolls when the rule does not fit -->
                <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource panel}">
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <!-- #editor: at least as tall as the body, so the lists of conditions and actions fill it (set in code) -->
                        <controls:FlexColumn x:Name="Editor" Gap="6" Margin="12,10" />
                    </ScrollViewer>
                </controls:Bevel>
            </DockPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
