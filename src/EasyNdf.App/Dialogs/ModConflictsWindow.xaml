<!--
  The Mod Conflicts window, opened from the Files tab's Conflicts button or a ⚠ on the Mods tab: every value more than
  one mod that is on changes, as the last Preview or export found them. Read-only: it shows the conflicts and changes
  nothing. The list at the left, by file and descriptor; at the right, the game's text and each mod's text around the
  value picked, side by side.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.ModConflictsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:dialogs="clr-namespace:EasyNdf.App.Dialogs"
             Visibility="Collapsed" PreviewKeyDown="KeyPressed">
    <UserControl.Resources>
        <!-- an arrow of previous and next: flat inside its raised group, the accent colour under the mouse -->
        <Style x:Key="NavArrow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource muted}" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed">
        <controls:Bevel TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="12,10,12,12" Margin="40,30" MaxWidth="1500" MaxHeight="900"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel>
                <!-- the title, "read-only", and what was found: how many values, by which run, the mods in their order -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Files.Conflicts.Close.Tip}" Click="CloseClicked" />
                    <TextBlock Text="{t:Text Files.Conflicts.Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" />
                    <Border BorderBrush="{DynamicResource line}" BorderThickness="1" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="{t:Text Files.Conflicts.ReadOnly.Tip}">
                        <TextBlock Text="{t:Text Files.Conflicts.ReadOnly}" FontSize="11" Foreground="{DynamicResource muted}" />
                    </Border>
                    <TextBlock x:Name="Summary" Foreground="{DynamicResource muted}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- the buttons along the bottom -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="{t:Text Files.Conflicts.CloseButton}" ToolTip="{t:Text Files.Conflicts.Close.Tip}" Click="CloseClicked" />
                    <controls:SnappedRow Gap="6">
                        <Button x:Name="FindAgainButton" Content="{t:Text Files.Conflicts.FindAgain}" ToolTip="{t:Text Files.Conflicts.FindAgain.Tip}" Click="FindAgainClicked" />
                        <Button Content="{t:Text Files.Conflicts.Copy}" ToolTip="{t:Text Files.Conflicts.Copy.Tip}" Click="CopyClicked" />
                    </controls:SnappedRow>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- the list: Find, the kinds and the mod, then the values by file and descriptor -->
                    <DockPanel Grid.Column="0">
                        <TextBox x:Name="FindBox" DockPanel.Dock="Top" Tag="{t:Text Files.Conflicts.Find.Hint}" ToolTip="{t:Text Files.Conflicts.Find.Tip}" TextChanged="FindChanged" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,6">
                            <ToggleButton x:Name="ClashToggle" Style="{StaticResource PressedToggle}" Padding="7,2" IsChecked="True" Click="FilterClicked" ToolTip="{t:Text Files.Conflicts.Clashes.Tip}" />
                            <ToggleButton x:Name="OverToggle" Style="{StaticResource PressedToggle}" Padding="7,2" Margin="4,0,0,0" IsChecked="True" Click="FilterClicked" ToolTip="{t:Text Files.Conflicts.Overwritten.Tip}" />
                            <ComboBox x:Name="ModChoice" Margin="6,0,0,0" ToolTip="{t:Text Files.Conflicts.Mod.Tip}" SelectionChanged="ModChosen" />
                        </DockPanel>
                        <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                            <Grid>
                                <ListBox x:Name="List" Style="{StaticResource LongTableLines}" PreviewMouseLeftButtonUp="ListClicked">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dialogs:ConflictRow}">
                                            <Border x:Name="Line" Padding="{Binding Indent}" BorderBrush="{DynamicResource line}" BorderThickness="0,0,0,1" Background="Transparent">
                                                <DockPanel>
                                                    <TextBlock x:Name="Count" DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource muted}" Margin="6,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Arrow}" Width="12" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Mark" Text="{Binding Mark}" Foreground="{DynamicResource caution}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Name" Text="{Binding Text}" Foreground="{DynamicResource ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text}" />
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="File">
                                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource panel}" />
                                                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource accent}" />
                                                    <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Descriptor">
                                                    <Setter TargetName="Name" Property="FontFamily" Value="{DynamicResource mono}" />
                                                    <Setter TargetName="Name" Property="FontSize" Value="11.5" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Value">
                                                    <Setter TargetName="Name" Property="FontFamily" Value="{DynamicResource mono}" />
                                                    <Setter TargetName="Name" Property="FontSize" Value="12" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsClash}" Value="True">
                                                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource warn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource sel}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="NothingFound" Style="{StaticResource Note}" Margin="8" Visibility="Collapsed" Text="{t:Text Files.Conflicts.NothingMatches}" />
                            </Grid>
                        </controls:Bevel>
                    </DockPanel>

                    <!-- the value picked: its name, previous and next, Show in File Editor; the panels; who wins -->
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button x:Name="ShowInEditorButton" DockPanel.Dock="Right" Content="{t:Text Files.Conflicts.ShowInEditor}" ToolTip="{t:Text Files.Conflicts.ShowInEditor.Tip}"
                                    Margin="8,0,0,0" Click="ShowInEditorClicked" />
                            <!-- previous and next: one raised group, with the place in the list between the arrows -->
                            <controls:Bevel DockPanel.Dock="Right" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PreviousButton" Style="{StaticResource NavArrow}" ToolTip="{t:Text Files.Conflicts.Previous.Tip}" Click="PreviousClicked">
                                        <Path Data="M6.5,1.5 L3,5 L6.5,8.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="10" Height="10" />
                                    </Button>
                                    <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}" Padding="8,0">
                                        <TextBlock x:Name="Place" FontSize="11.5" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                                    </controls:Bevel>
                                    <Button x:Name="NextButton" Style="{StaticResource NavArrow}" ToolTip="{t:Text Files.Conflicts.Next.Tip}" Click="NextClicked">
                                        <Path Data="M3.5,1.5 L7,5 L3.5,8.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="10" Height="10" />
                                    </Button>
                                </StackPanel>
                            </controls:Bevel>
                            <TextBlock x:Name="ValueName" FontFamily="{DynamicResource mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <controls:Bevel DockPanel.Dock="Bottom" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}"
                                        Padding="9,5" Margin="0,8,0,0">
                            <TextBlock x:Name="Verdict" TextWrapping="Wrap" Foreground="{DynamicResource muted}" />
                        </controls:Bevel>
                        <!-- the panels side by side; more than fit scroll sideways -->
                        <ScrollViewer x:Name="PanelScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" SizeChanged="PanelRoomChanged">
                            <StackPanel x:Name="Panels" Orientation="Horizontal" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </controls:Bevel>
    </Grid>

</UserControl>
