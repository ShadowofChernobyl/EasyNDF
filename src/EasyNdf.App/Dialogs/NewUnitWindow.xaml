<!--
  The New Unit window, in four steps listed at the top: Model (the unit whose 3D model the new one takes), Name and Nation,
  Stats, then Weapons. 1600 pixels wide for Model and Weapons, 1000 for the others, steps up to 760 tall, or 96% of a smaller window, centred on the dimmed backdrop as the other windows.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.NewUnitWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:dialogs="clr-namespace:EasyNdf.App.Dialogs"
             xmlns:units="clr-namespace:EasyNdf.App.Units"
             Visibility="Collapsed" KeyDown="KeyPressed" Foreground="{DynamicResource ink}">
    <UserControl.Resources>
        <!-- a sunken box, as the Armory's lists -->
        <Style x:Key="SunkenBox" TargetType="controls:Bevel">
            <Setter Property="TopLeft" Value="{DynamicResource lo}" />
            <Setter Property="BottomRight" Value="{DynamicResource hi}" />
            <Setter Property="Background" Value="{DynamicResource well}" />
        </Style>
    </UserControl.Resources>
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed" SizeChanged="BackdropResized">
        <controls:Bevel x:Name="Box" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="14,12" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel>
                <!-- the title and the steps, with a line under them -->
                <controls:Bevel DockPanel.Dock="Top" BottomRight="{DynamicResource line}" Edges="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Common.TextWindow.CloseEscape.Tip}" Click="CancelClicked" />
                        <TextBlock Text="{t:Text Units.New.Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" Margin="0,0,24,0" />
                        <StackPanel x:Name="StepStrip" Orientation="Horizontal" VerticalAlignment="Center" />
                    </DockPanel>
                </controls:Bevel>

                <!-- the foot: what to do next, then the buttons -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{t:Text Common.Cancel}" Margin="6,0,0,0" Click="CancelClicked" />
                    <Button x:Name="CreateButton" DockPanel.Dock="Right" Style="{StaticResource GoButton}" Content="{t:Text Units.New.Create}" ToolTip="{t:Text Units.New.Create.Tip}"
                            Margin="6,0,0,0" Click="CreateClicked" />
                    <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource GoButton}" Content="{t:Text Units.New.Next}" Margin="6,0,0,0" Click="NextClicked" />
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Content="{t:Text Units.New.Back}" Margin="0,0,10,0" Click="BackClicked" />
                    <TextBlock x:Name="HintText" Foreground="{DynamicResource muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Grid>
                    <!-- step 1: the units whose model to use, as the Armory's Units sub-tab, and the one chosen at the right -->
                    <Grid x:Name="ModelStep" Height="440">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <!-- the filters: side, nations, role -->
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <controls:Bevel Style="{StaticResource Heading}"><TextBlock Text="{t:Text Units.New.Side}" /></controls:Bevel>
                                <StackPanel x:Name="SideChoices" Orientation="Horizontal" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <controls:Bevel Style="{StaticResource Heading}"><TextBlock Text="{t:Text Units.New.Role}" /></controls:Bevel>
                                <ComboBox x:Name="RoleFilter" ToolTip="{t:Text Units.RoleChoice.Tip}" SelectionChanged="RoleFilterChosen" />
                            </StackPanel>
                            <controls:Bevel DockPanel.Dock="Top" Style="{StaticResource Heading}"><TextBlock Text="{t:Text Units.Nations}" /></controls:Bevel>
                            <controls:Bevel Style="{StaticResource SunkenBox}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel x:Name="NationList" />
                                </ScrollViewer>
                            </controls:Bevel>
                        </DockPanel>

                        <!-- the search, Cards or Table, how many; the type tabs; the units -->
                        <DockPanel Grid.Column="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock x:Name="ModelCountText" DockPanel.Dock="Right" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <ToggleButton x:Name="CardsViewButton" Style="{StaticResource PressedToggle}" Padding="5,4" AutomationProperties.Name="{t:Text Units.Cards}"
                                                  ToolTip="{t:Text Units.New.Cards.Tip}" Click="ViewClicked">
                                        <controls:ViewIcon Shape="Cards" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="TableViewButton" Style="{StaticResource PressedToggle}" Padding="5,4" Margin="-1,0,0,0" AutomationProperties.Name="{t:Text Units.Table}"
                                                  ToolTip="{t:Text Units.New.Table.Tip}" Click="ViewClicked">
                                        <controls:ViewIcon Shape="Table" />
                                    </ToggleButton>
                                </StackPanel>
                                <TextBox x:Name="SearchBox" Tag="{t:Text Units.SearchBox.Hint}" ToolTip="{t:Text Units.SearchBox.Tip}" TextChanged="SearchChanged" />
                            </DockPanel>
                            <controls:Bevel DockPanel.Dock="Top" BottomRight="{DynamicResource line}" Edges="0,0,0,1">
                                <WrapPanel x:Name="FactoryTabs" />
                            </controls:Bevel>
                            <controls:Bevel Style="{StaticResource SunkenBox}">
                                <ItemsControl x:Name="ModelList" Focusable="False" SizeChanged="ModelListResized"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type dialogs:ModelLine}">
                                            <dialogs:ModelRow />
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type units:CardRowLine}">
                                            <units:CardRowView />
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type units:EmptyLine}">
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource muted}" Margin="8" />
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                            </controls:Bevel>
                        </DockPanel>

                        <!-- the unit chosen: larger, with what comes with it and what does not -->
                        <controls:Bevel Grid.Column="4" BottomRight="{DynamicResource line}" TopLeft="{DynamicResource line}" Edges="1,0,0,0" Padding="12,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ContentControl x:Name="ModelDetails" Focusable="False" />
                            </ScrollViewer>
                        </controls:Bevel>
                    </Grid>

                    <!-- steps 2 to 4: the new unit's tile at the left, as it will be; the step's boxes at the right -->
                    <Grid x:Name="DetailsSteps" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ContentControl x:Name="PreviewSlot" Focusable="False" />
                            <TextBlock x:Name="ModelOfText" Foreground="{DynamicResource muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <!-- step 2: name, nation, role and card picture -->
                        <Grid x:Name="NameStep" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" MaxWidth="320" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{t:Text Units.New.Name}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="2" ToolTip="{t:Text Units.New.Name.Tip}" Margin="0,0,0,8" TextChanged="NameChanged" />
                            <TextBlock Grid.Row="1" Text="{t:Text Units.New.Nation}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                            <ComboBox x:Name="NationChoice" Grid.Row="1" Grid.Column="2" ToolTip="{t:Text Units.New.Nation.Tip}" Margin="0,0,0,8" SelectionChanged="DetailChosen" />
                            <TextBlock Grid.Row="2" Text="{t:Text Units.New.Role}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                            <ComboBox x:Name="RoleChoice" Grid.Row="2" Grid.Column="2" ToolTip="{t:Text Units.New.Role.Tip}" Margin="0,0,0,8" SelectionChanged="DetailChosen" />
                            <TextBlock Grid.Row="3" Text="{t:Text Units.New.Picture}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <!-- two buttons that stay pressed, joined, as the Armory's side buttons -->
                                <ToggleButton x:Name="ModelPictureChoice" Style="{StaticResource PressedToggle}" Padding="9,1"
                                              ToolTip="{t:Text Units.New.Picture.Model.Tip}" IsChecked="True" Click="ModelPictureClicked" />
                                <ToggleButton x:Name="OwnPictureChoice" Style="{StaticResource PressedToggle}" Padding="9,1" Margin="-1,0,0,0" Content="{t:Text Units.New.Picture.Own}"
                                              ToolTip="{t:Text Units.New.Picture.Own.Tip}" Click="OwnPictureClicked" />
                            </StackPanel>
                            <TextBlock x:Name="PictureFileText" Grid.Row="4" Grid.Column="2" Foreground="{DynamicResource muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <!-- step 3: the stats, in the Unit pane's categories, each empty until given -->
                        <ScrollViewer x:Name="StatsStep" Grid.Column="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" MaxHeight="440">
                            <StackPanel x:Name="StatsPanel" />
                        </ScrollViewer>
                        <!-- step 4: the model unit's weapons, turret by turret in a sunken box, to swap, change, take off or
                             add; the Checks at the right -->
                        <Grid x:Name="WeaponsStep" Grid.Column="2" Visibility="Collapsed" Height="440">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <controls:Bevel Style="{StaticResource SunkenBox}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ContentControl x:Name="WeaponsPanel" Focusable="False" Margin="7" />
                                </ScrollViewer>
                            </controls:Bevel>
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ContentControl x:Name="WeaponChecksPanel" Focusable="False" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </DockPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
