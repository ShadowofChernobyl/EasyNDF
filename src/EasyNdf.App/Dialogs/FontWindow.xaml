<!--
  The Fonts window, opened from Settings, Appearance: the interface font and the code font, for every theme. Each is a
  list of the fonts on this computer, as Windows' own font window has, with a box above it to search by name; each font
  is named in the usual font, with a sample in its own. The code list shows fixed-width fonts only, unless told not to.
  A sample of both is under the lists. FontWindow.xaml.cs fills it in, and OK saves and applies the choice.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.FontWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:dialogs="clr-namespace:EasyNdf.App.Dialogs"
             Visibility="Collapsed">
    <UserControl.Resources>
        <!-- a list of fonts: a row each, under the mouse in the hover colour, chosen on the selection colour with an accent mark -->
        <Style x:Key="FontList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ink}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid x:Name="Row" Background="Transparent">
                                        <Border x:Name="Mark" Width="2" HorizontalAlignment="Left" Background="{DynamicResource accent}" Visibility="Collapsed" />
                                        <ContentPresenter Margin="8,3,8,3" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource sel}" />
                                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a font in a list: its name in the usual font, and a sample in its own at the right, dimmed -->
        <DataTemplate DataType="{x:Type dialogs:FontChoice}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="AaBbYy 0123" FontFamily="{Binding Face}" FontSize="13" Foreground="{DynamicResource muted}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- the dimmed backdrop; a click on it closes the window without changing anything -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed">
        <controls:Bevel TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="12,10,12,12" Width="660" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Settings.Fonts.CancelEscape.Tip}" Click="CancelClicked" />
                    <TextBlock Text="{t:Text Settings.Fonts.Fonts}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" Text="{t:Text Settings.Fonts.ForEveryThemeThe}" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- the interface font -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{t:Text Settings.Fonts.InterfaceFont}" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBox x:Name="UiSearch" DockPanel.Dock="Top" Tag="{t:Text Settings.Fonts.UiSearch.Hint}" ToolTip="{t:Text Settings.Fonts.UiSearch.Tip}"
                                 TextChanged="SearchChanged" />
                        <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}"
                                        Margin="0,4,0,0" Height="240">
                            <ListBox x:Name="UiList" Style="{StaticResource FontList}" SelectionChanged="FontPicked" ToolTip="{t:Text Settings.Fonts.UiList.Tip}" />
                        </controls:Bevel>
                    </DockPanel>

                    <!-- the code font -->
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <CheckBox x:Name="FixedOnly" DockPanel.Dock="Right" Style="{StaticResource Tick}" Content="{t:Text Settings.Fonts.FixedWidthOnly}" IsChecked="True"
                                      ToolTip="{t:Text Settings.Fonts.FixedOnly.Tip}" Click="FixedOnlyClicked" />
                            <TextBlock Text="{t:Text Settings.Fonts.CodeFont}" FontWeight="Bold" />
                        </DockPanel>
                        <TextBox x:Name="CodeSearch" DockPanel.Dock="Top" Tag="{t:Text Settings.Fonts.UiSearch.Hint}" ToolTip="{t:Text Settings.Fonts.UiSearch.Tip}"
                                 TextChanged="SearchChanged" />
                        <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}"
                                        Margin="0,4,0,0" Height="240">
                            <ListBox x:Name="CodeList" Style="{StaticResource FontList}" SelectionChanged="FontPicked" ToolTip="{t:Text Settings.Fonts.CodeList.Tip}" />
                        </controls:Bevel>
                    </DockPanel>
                </Grid>

                <!-- the sample: a line in each font, as the app would show them -->
                <TextBlock Text="{t:Text Settings.Fonts.Sample}" Foreground="{DynamicResource muted}" Margin="0,10,0,3" />
                <Border Padding="8,6" BorderThickness="1" BorderBrush="{DynamicResource line}" Background="{DynamicResource well}">
                    <StackPanel>
                        <TextBlock x:Name="UiSample" FontSize="13" Text="{t:Text Settings.Fonts.RulesRunTopTo}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CodeSample" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource s-field}"
                                   Text="MaximumRangeGRU = 2450   // 0O 1lI {} [] ()" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,10,0,0">
                    <Button Content="{t:Text Settings.Fonts.UseTheThemesFonts}" ToolTip="{t:Text Settings.Fonts.UseTheThemesFonts.Tip}" Click="ThemeFontsClicked" />
                    <controls:SnappedRow Gap="6" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GoButton}" Content="OK" MinWidth="72" ToolTip="{t:Text Settings.Fonts.UseTheseFontsEnter.Tip}" Click="OkClicked" />
                        <Button Content="{t:Text Settings.Fonts.Cancel}" MinWidth="72" ToolTip="{t:Text Settings.Fonts.Cancel.Tip}" Click="CancelClicked" />
                    </controls:SnappedRow>
                </DockPanel>
            </StackPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
