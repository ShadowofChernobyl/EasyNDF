<!--
  The Add Units window: find units by name, side, type, nation and role, tick as many as wanted, then Add. Compare uses
  it; it takes the units and what Add does, so other tabs can use it too. 760 pixels wide, or 96% of a narrower window.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.AddUnitsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:dialogs="clr-namespace:EasyNdf.App.Dialogs"
             Visibility="Collapsed" KeyDown="KeyPressed" Foreground="{DynamicResource ink}">
    <!-- the dimmed backdrop; a click on it closes the window -->
    <Grid x:Name="Backdrop" Background="#80000000" MouseLeftButtonDown="BackdropPressed" SizeChanged="BackdropResized">
        <controls:Bevel x:Name="Box" TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="14,12" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Common.TextWindow.CloseEscape.Tip}" Click="CancelClicked" />
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- the filters: the search and the sides, then type, nation and role -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Tag="{t:Text Units.SearchBox.Hint}" ToolTip="{t:Text Units.SearchBox.Tip}" TextChanged="FilterChanged" />
                    <StackPanel x:Name="SideChoices" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" />
                </Grid>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="FactoryChoice" Grid.Column="0" ToolTip="{t:Text Units.AddUnits.Factory.Tip}" SelectionChanged="FilterChosen" />
                    <ComboBox x:Name="NationChoice" Grid.Column="2" ToolTip="{t:Text Units.AddUnits.Nation.Tip}" SelectionChanged="FilterChosen" />
                    <ComboBox x:Name="RoleChoice" Grid.Column="4" ToolTip="{t:Text Units.RoleChoice.Tip}" SelectionChanged="FilterChosen" />
                </Grid>

                <!-- the foot: how many units match, Cancel and Add -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="AddButton" DockPanel.Dock="Right" Content="{t:Text Units.AddUnits.Add}" ToolTip="{t:Text Units.AddUnits.Add.Tip}" Margin="6,0,0,0" IsEnabled="False" Click="AddClicked" />
                    <Button DockPanel.Dock="Right" Content="{t:Text Common.Cancel}" Click="CancelClicked" />
                    <TextBlock x:Name="CountText" Foreground="{DynamicResource muted}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- the units, of which only those in view are made -->
                <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}" Height="330">
                    <ItemsControl x:Name="UnitList" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type dialogs:AddUnitsLine}">
                                <dialogs:AddUnitsRow />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type dialogs:AddUnitsEmptyLine}">
                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource muted}" Margin="8" />
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </controls:Bevel>
            </DockPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
