<!--
  The Generation Settings window of a generated battlegroup, opened by "⚙ Generation Settings…" in its heading on the
  Armory's Battlegroups sub-tab: the ready settings, the eight weights, the picks each role gets and the size; what
  changes, with the battlegroup behind redrawn; Make Fixed, Done and Cancel.
-->
<UserControl x:Class="EasyNdf.App.Dialogs.GenerationSettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             Visibility="Collapsed" KeyDown="KeyPressed">
    <!-- the dimmed backdrop, light enough to see the battlegroup redrawn behind; a click on it cancels -->
    <Grid x:Name="Backdrop" Background="#60000000" MouseLeftButtonDown="BackdropPressed">
        <controls:Bevel TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                        Padding="12,10,12,12" Width="820" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="BoxPressed" KeyboardNavigation.TabNavigation="Cycle">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="{t:Text Divisions.Battlegroup.Generation.Cancel.Tip}" Click="CancelClicked" />
                    <TextBlock Text="{t:Text Divisions.Battlegroup.Generation.Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" />
                    <TextBlock x:Name="BattlegroupName" Foreground="{DynamicResource muted}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <controls:Bevel Style="{StaticResource Heading}"><TextBlock Text="{t:Text Divisions.Battlegroup.Generation.StartFrom}" /></controls:Bevel>
                        <WrapPanel x:Name="ReadySettings" Margin="0,4,0,8" />
                        <controls:Bevel Style="{StaticResource Heading}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontWeight="Normal" FontSize="11.5">
                                    <Hyperlink x:Name="BackToReadyLink" Style="{StaticResource CrumbLink}" ToolTip="{t:Text Divisions.Battlegroup.Generation.BackTo.Tip}" Click="BackToReadyClicked"><Run x:Name="BackToReadyText" /></Hyperlink>
                                </TextBlock>
                                <TextBlock Text="{t:Text Divisions.Battlegroup.Generation.WhatMatters}" />
                            </DockPanel>
                        </controls:Bevel>
                        <Grid x:Name="Weights" Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <controls:Bevel Style="{StaticResource Heading}"><TextBlock Text="{t:Text Divisions.Battlegroup.Generation.ForEachRole}" /></controls:Bevel>
                                <CheckBox x:Name="BestTick" Style="{StaticResource Tick}" Content="{t:Text Divisions.Battlegroup.Generation.Best}" ToolTip="{t:Text Divisions.Battlegroup.Generation.Best.Tip}" Margin="0,4,0,2" Click="ChoiceChanged" />
                                <CheckBox x:Name="GoodValueTick" Style="{StaticResource Tick}" Content="{t:Text Divisions.Battlegroup.Generation.GoodValue}" ToolTip="{t:Text Divisions.Battlegroup.Generation.GoodValue.Tip}" Margin="0,2" Click="ChoiceChanged" />
                                <CheckBox x:Name="CheapTick" Style="{StaticResource Tick}" Content="{t:Text Divisions.Battlegroup.Generation.Cheap}" ToolTip="{t:Text Divisions.Battlegroup.Generation.Cheap.Tip}" Margin="0,2" Click="ChoiceChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <controls:Bevel Style="{StaticResource Heading}"><TextBlock Text="{t:Text Divisions.Battlegroup.Generation.Size}" /></controls:Bevel>
                                <DockPanel Margin="0,4,0,2">
                                    <TextBox x:Name="CardsBox" DockPanel.Dock="Right" Width="50" ToolTip="{t:Text Divisions.Battlegroup.Generation.Cards.Tip}" TextChanged="NumberChanged" />
                                    <TextBlock Text="{t:Text Divisions.Battlegroup.Generation.Cards}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBox x:Name="PointsBox" DockPanel.Dock="Right" Width="50" ToolTip="{t:Text Divisions.Battlegroup.Generation.Points.Tip}" TextChanged="NumberChanged" />
                                    <TextBlock Text="{t:Text Divisions.Battlegroup.Generation.Points}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <!-- what the settings change, against the battlegroup as it is saved -->
                    <StackPanel Grid.Column="2">
                        <controls:Bevel Style="{StaticResource Heading}"><TextBlock Text="{t:Text Divisions.Battlegroup.Generation.WhatChanges}" /></controls:Bevel>
                        <DockPanel Margin="0,4,0,4">
                            <TextBlock x:Name="PointsSummary" DockPanel.Dock="Right" />
                            <TextBlock x:Name="CardsSummary" />
                        </DockPanel>
                        <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}" Height="250">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel x:Name="Changes" Margin="6,4" />
                            </ScrollViewer>
                        </controls:Bevel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{t:Text Divisions.Battlegroup.Generation.Behind}" />
                    </StackPanel>
                </Grid>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Hyperlink Style="{StaticResource CrumbLink}" ToolTip="{t:Text Divisions.Battlegroup.Generation.MakeFixed.Tip}" Click="MakeFixedClicked"><Run Text="{t:Text Divisions.Battlegroup.Generation.MakeFixed}" /></Hyperlink>
                    </TextBlock>
                    <controls:SnappedRow DockPanel.Dock="Right" Gap="6">
                        <Button x:Name="DoneButton" Style="{StaticResource GoButton}" Content="{t:Text Divisions.Battlegroup.Generation.Done}" ToolTip="{t:Text Divisions.Battlegroup.Generation.Done.Tip}" Click="DoneClicked" />
                        <Button Content="{t:Text Common.Cancel}" ToolTip="{t:Text Divisions.Battlegroup.Generation.Cancel.Tip}" Click="CancelClicked" />
                    </controls:SnappedRow>
                    <TextBlock Style="{StaticResource Note}" Margin="12,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{t:Text Divisions.Battlegroup.Generation.Kept}" />
                </DockPanel>
            </StackPanel>
        </controls:Bevel>
    </Grid>
</UserControl>
