<!--
  The Files tab (the HTML app's #pageJobs): the button bars, the file list and the Details section. Its data is a
  FileListModel (Files/FileListModel.cs); FilesPage.xaml.cs passes the clicks on to it.
-->
<UserControl x:Class="EasyNdf.App.Pages.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:files="clr-namespace:EasyNdf.App.Files">
    <UserControl.Resources>
        <!-- tbody tr: a line under each row; selected rows are drawn in the selection colour -->
        <Style x:Key="FileListRow" TargetType="controls:Bevel">
            <Setter Property="BottomRight" Value="{DynamicResource line}" />
            <Setter Property="Edges" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource sel}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- td.mono: the file's name in the code font; dim while the file is off -->
        <Style x:Key="FileName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17.4" />
            <Setter Property="TextTrimming" Value="{DynamicResource list-trimming}" />
            <Setter Property="TextWrapping" Value="{DynamicResource list-wrapping}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource muted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- td.st: dim; the success, caution or warning colour for what the last run did -->
        <Style x:Key="FileStatus" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{DynamicResource muted}" />
            <Setter Property="TextTrimming" Value="{DynamicResource list-trimming}" />
            <Setter Property="TextWrapping" Value="{DynamicResource list-wrapping}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Idle">
                    <Setter Property="Foreground" Value="{DynamicResource caution}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- td.acts: the row's buttons, on the well colour (the selection colour when selected), 2 pixels in on the left -->
        <Style x:Key="FileButtonsCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource well}" />
            <Setter Property="Padding" Value="2,3,7,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource sel}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- the bars stay at the top; the file list and Details share the rest of the window, beside or below each other -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">

            <!-- .jobbar: adding and removing files on the left, running the rules on the right; in a narrow window the
                 running buttons go on a second line -->
            <controls:FlexRow Gap="6" LineGap="6" Margin="0,0,0,8">
                <controls:SnappedRow Gap="6">
                    <!-- bold while the list is empty: then adding files is the thing to do -->
                    <Button x:Name="AddFilesButton" ToolTip="Add .ndf files, or a .zip or .rar holding them" Click="AddFilesClicked" Content="Add files..." Style="{StaticResource GoButton}" IsEnabled="{Binding IsIdle}" />
                    <Button x:Name="AddFolderButton" ToolTip="Add every .ndf file in a folder and its subfolders" Click="AddFolderClicked" Content="Add folder..." IsEnabled="{Binding IsIdle}" />
                    <Button x:Name="SelectAllButton" ToolTip="Select all shown files (Ctrl+A). Again to clear" Click="SelectAllClicked" Content="Select all" />
                    <controls:Bevel Style="{StaticResource BarSeparator}" />
                    <Button x:Name="ExportFolderButton" ToolTip="Set the export folder of the selected files" Content="Export folder..." Click="ExportFolderClicked" IsEnabled="{Binding CanChangeSelected}" />
                    <Button x:Name="RemoveButton" ToolTip="Remove the selected files from the list (Delete)" Click="RemoveClicked" Content="Remove" IsEnabled="{Binding CanChangeSelected}" />
                    <Button x:Name="RemoveAllButton" ToolTip="Remove all files from the list" Click="RemoveAllClicked" Content="Remove all" IsEnabled="{Binding CanRemoveAll}" />
                </controls:SnappedRow>
                <!-- takes the spare room, keeping the running buttons at the right -->
                <FrameworkElement controls:FlexRow.Grow="1" controls:FlexRow.Basis="0" />
                <controls:SnappedRow Gap="6">
                    <Button x:Name="PreviewButton" ToolTip="Run the rules without saving" Content="Preview" Click="PreviewClicked" IsEnabled="{Binding IsIdle}" />
                    <!-- the main action once there are files; while the list is empty, Add files is -->
                    <Button x:Name="RunButton" ToolTip="Run the rules and export" Content="Run export" Click="RunClicked" IsEnabled="{Binding IsIdle}" />
                    <!-- the HTML app's Download: here the files are already in their folders, so this packs them into one .zip -->
                    <Button x:Name="SaveZipButton" ToolTip="Save the last export as a .zip" Content="Save as zip..." Click="SaveZipClicked" IsEnabled="{Binding CanSaveZip}" />
                    <Button Style="{StaticResource HelpButton}" VerticalAlignment="Center" controls:QuickHelp.Page="tab-files" />
                </controls:SnappedRow>
            </controls:FlexRow>

            <!-- #findBar: search, show only, columns, group by folder; wrapping in a narrow window -->
            <controls:FlexRow Gap="6" LineGap="6" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" ToolTip="Filter by file or folder name" Width="320" Tag="Search files" TextChanged="SearchChanged" />
                <!-- in the order of the ShowOnly choices in EasyNdf.Data/FileList/FileListView.cs -->
                <ComboBox x:Name="ShowOnlyChoice" ToolTip="Filter by state" Width="176" SelectedIndex="0" SelectionChanged="ShowOnlyChanged">
                    <ComboBoxItem Content="All files" />
                    <ComboBoxItem Content="Has a preset" />
                    <ComboBoxItem Content="No preset" />
                    <ComboBoxItem Content="On" />
                    <ComboBoxItem Content="Off" />
                    <ComboBoxItem Content="Changed" />
                    <ComboBoxItem Content="Errors or warnings" />
                    <ComboBoxItem Content="A rule changed nothing" />
                    <ComboBoxItem Content="Not read" />
                </ComboBox>
                <!-- #colWrap: the Columns button, and the popup that shows or hides columns, 2 pixels under it -->
                <Grid>
                    <Button x:Name="ColumnsButton" Content="Columns" ToolTip="Show or hide columns" Click="ColumnsClicked" />
                    <Popup x:Name="ColumnsPopup" PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom" VerticalOffset="2"
                           StaysOpen="False" AllowsTransparency="True">
                        <controls:Bevel TopLeft="{DynamicResource hi}" BottomRight="{DynamicResource lo}" Background="{DynamicResource panel}"
                                        Padding="10,8" MinWidth="192" TextElement.FontFamily="{DynamicResource ui-font}" TextElement.FontSize="12.5"
                                        TextBlock.LineHeight="18.125" TextBlock.LineStackingStrategy="BlockLineHeight" TextOptions.TextFormattingMode="Ideal"
                                        UseLayoutRounding="False">
                            <StackPanel x:Name="ColumnChoices" />
                        </controls:Bevel>
                    </Popup>
                </Grid>
                <CheckBox x:Name="GroupByFolder" ToolTip="Group files by folder" Style="{StaticResource Toggle}" Content="Group by folder" VerticalAlignment="Center"
                          IsChecked="{Binding GroupByFolder}" />
                <!-- shown while grouping by folder -->
                <Button x:Name="ExpandAllButton" ToolTip="Expand all folders" Content="Expand all" Click="ExpandAllClicked"
                        Visibility="{Binding GroupByFolder, Converter={StaticResource ShowWhenTrue}}" />
                <Button x:Name="CollapseAllButton" ToolTip="Collapse all folders" Content="Collapse all" Click="CollapseAllClicked"
                        Visibility="{Binding GroupByFolder, Converter={StaticResource ShowWhenTrue}}" />
                <!-- #jobCount: how many rows a search or filter leaves -->
                <TextBlock x:Name="ShownCount" Style="{StaticResource Note}" Text="{Binding ShownCount}" VerticalAlignment="Center" />
            </controls:FlexRow>

            <!-- #jobNote: what the last action did, and how to select rows; it takes no room while it has nothing to say -->
            <TextBlock x:Name="Note" Text="{Binding Note}" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNote}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!-- span.caut: a warning, such as "Nothing to run." -->
                            <DataTrigger Binding="{Binding NoteIsCaution}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource caution}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <controls:PanePair x:Name="Panes" Key="files" SecondTitle="Details" FoldedTitle="Details" FoldedAtFirst="True" DefaultBeside="520" DefaultBelow="300">
            <controls:PanePair.Main>
                <DockPanel>
                    <!-- h2: the File List heading -->
                    <controls:Bevel Style="{StaticResource Heading}" DockPanel.Dock="Top">
                        <TextBlock Text="File List" />
                    </controls:Bevel>
                    <!-- #jobWrap: the list, with the outline that shows while files are dragged over the app -->
                    <Grid x:Name="ListArea">
                        <!-- #jobBox: the file list, a sunken box that fills the pane -->
                        <controls:Bevel x:Name="ListBox" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                            <!--
                              The rows, of which only those in view are made, so a list of a thousand files stays quick. The headings
                              sit above them in the list's scrolling frame (Styles/Controls.xaml, ListScroller), set in FilesPage.xaml.cs.
                            -->
                            <ItemsControl x:Name="Rows" ItemsSource="{Binding ListItems}" Focusable="False"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer x:Name="ListScroller" Style="{StaticResource ListScroller}" Focusable="False"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <!-- td.empty: what the list says while it has nothing to show -->
                                    <DataTemplate DataType="{x:Type files:EmptyListItem}">
                                        <controls:Bevel BottomRight="{DynamicResource line}" Edges="0,0,0,1" Padding="10">
                                            <TextBlock Foreground="{DynamicResource muted}" Text="{Binding Text}" />
                                        </controls:Bevel>
                                    </DataTemplate>
                                    <!-- tr.fold: with "Group by folder", the line above a folder's files, on the panel colour -->
                                    <DataTemplate DataType="{x:Type files:FolderRow}">
                                        <controls:Bevel BottomRight="{DynamicResource line}" Edges="0,0,0,1" Background="{DynamicResource panel}"
                                                        Cursor="Hand" MouseLeftButtonUp="FolderClicked">
                                            <Grid TextElement.Foreground="{DynamicResource ink}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding DataContext.Columns.First, ElementName=Rows}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource Tick}" Margin="7,8,7,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          IsChecked="{Binding AllOn, Mode=OneWay}" Click="FolderOnClicked"
                                                          ToolTip="Switch every file in this folder on or off" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="7,3" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Content="{Binding Arrow}" Click="FolderToggleClicked" ToolTip="Collapse or expand this folder" />
                                                    <!-- a space, then the path in the code font, then the count, dim, 8 pixels on -->
                                                    <TextBlock Text=" " />
                                                    <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource mono}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </controls:Bevel>
                                    </DataTemplate>
                                    <!-- a file's row: built from the shown columns (Files/FileRowView.cs), styled by FileListRow and the styles after it -->
                                    <DataTemplate DataType="{x:Type files:FileRow}">
                                        <files:FileRowView List="{Binding DataContext, ElementName=Rows}" />
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </controls:Bevel>

                        <Rectangle x:Name="DropHint" Stroke="{DynamicResource accent}" StrokeThickness="2" StrokeDashArray="3 3"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </controls:PanePair.Main>
            <controls:PanePair.Second>
                <!-- #details: what the selected file's last run did; it scrolls in its pane -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <!-- what Details says until a row is clicked or run; then Files/DetailsPanel.cs takes over -->
                    <ContentControl x:Name="DetailsArea" Focusable="False">
                        <TextBlock Foreground="{DynamicResource muted}" Margin="10" Text="Select a file to see its last run." />
                    </ContentControl>
                </ScrollViewer>
            </controls:PanePair.Second>
        </controls:PanePair>
    </DockPanel>
</UserControl>
