<!--
  The Theme Designer, under the Appearance settings on the Settings tab (the HTML app's .tdz): buttons for the user's own
  themes, a note, and beside the preview the colours and scrollbars of the theme in use when it is the user's own.
  ThemeDesigner.xaml.cs fills in the rows and saves each change at once.
-->
<UserControl x:Class="EasyNdf.App.Pages.ThemeDesigner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:pages="clr-namespace:EasyNdf.App.Pages">
    <!-- in the Appearance card, under its own heading -->
    <controls:Bevel Edges="0" Padding="12">
        <StackPanel>
            <controls:WrapRow Gap="6" Margin="0,0,0,8">
                <Button Content="{t:Text Settings.Designer.NewFromThisTheme}" ToolTip="{t:Text Settings.Designer.NewFromThisTheme.Tip}" Click="NewClicked" />
                <Button x:Name="RenameButton" Content="{t:Text Settings.Designer.Rename}" ToolTip="{t:Text Settings.Designer.Rename.Tip}" Click="RenameClicked" />
                <Button x:Name="DeleteButton" Content="{t:Text Settings.Designer.Delete}" ToolTip="{t:Text Settings.Designer.Delete.Tip}" Click="DeleteClicked" />
                <Button x:Name="ResetButton" Content="{t:Text Settings.Designer.ResetColors}" ToolTip="{t:Text Settings.Designer.Reset.Tip}" Click="ResetClicked" />
                <Button x:Name="ExportButton" Content="{t:Text Settings.Designer.ExportTheme}" ToolTip="{t:Text Settings.Designer.Export.Tip}" Click="ExportClicked" />
                <Button Content="{t:Text Settings.Designer.ImportTheme}" ToolTip="{t:Text Settings.Designer.ImportTheme.Tip}" Click="ImportClicked" />
            </controls:WrapRow>
            <TextBlock x:Name="Note" Style="{StaticResource Note}" />

            <!-- .tdgrid: the colours (27rem) beside the preview; one above the other when the window is narrow -->
            <Grid x:Name="Columns" Margin="0,10,0,0" SizeChanged="ColumnsResized">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColoursColumn" Width="432" />
                    <ColumnDefinition x:Name="GapColumn" Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="GapRow" Height="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="Colours" VerticalAlignment="Top">
                    <!-- the colours of the app itself, then its scrollbars -->
                    <controls:Bevel Style="{StaticResource ThemeBox}">
                        <StackPanel>
                            <controls:Bevel Style="{StaticResource CardHeading}"><TextBlock Text="{t:Text Settings.Designer.InterfaceColors}" /></controls:Bevel>
                            <Grid x:Name="InterfaceRows" Margin="12,10" />
                        </StackPanel>
                    </controls:Bevel>
                    <!-- .tbox.ed: the colours of the File Editor's text, marked by a 3-pixel stripe of the accent colour on the left -->
                    <Grid Margin="0,14,0,0">
                        <controls:Bevel Style="{StaticResource ThemeBox}" Padding="2,0,0,0">
                            <StackPanel>
                                <controls:Bevel Style="{StaticResource CardHeading}" Background="{DynamicResource sel}"><TextBlock Text="{t:Text Settings.Designer.EditorColors}" /></controls:Bevel>
                                <Grid x:Name="EditorRows" Margin="12,10" />
                            </StackPanel>
                        </controls:Bevel>
                        <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource accent}" />
                    </Grid>
                </StackPanel>
                <pages:ThemePreview x:Name="Preview" Grid.Column="2" VerticalAlignment="Top" />
            </Grid>
        </StackPanel>
    </controls:Bevel>
</UserControl>
