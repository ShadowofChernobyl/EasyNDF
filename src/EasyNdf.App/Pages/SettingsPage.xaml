<!--
  The Settings tab (the HTML app's #pageSettings): cards of settings, each saved as soon as it is changed. The browser's
  own rows (downloads, themed dropdowns) are left out. The Language card is the desktop app's own.
  SettingsPage.xaml.cs reads and writes the settings.
-->
<UserControl x:Class="EasyNdf.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:pages="clr-namespace:EasyNdf.App.Pages">
    <!-- every category on one page that scrolls; the list on the left jumps to each and marks the one in view -->
    <DockPanel>
        <!-- .bar.qtop: the ? at the right -->
        <Button DockPanel.Dock="Top" Style="{StaticResource HelpButton}" HorizontalAlignment="Right" Margin="0,0,0,6" controls:QuickHelp.Page="tab-settings" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Bevel TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <!-- the search box above the list, as on the Help tab; it hides the settings that do not match -->
                    <StackPanel Margin="8">
                        <TextBox x:Name="SettingsSearch" Margin="0,0,0,8" Tag="{t:Text Settings.SettingsSearch.Hint}" ToolTip="{t:Text Settings.SettingsSearch.Tip}"
                                 TextChanged="SearchChanged" KeyDown="SearchKeyDown" />
                        <TextBlock x:Name="NoMatch" Style="{StaticResource Note}" Margin="4,0,0,0" Text="{t:Text Settings.NoSettingsMatch}" Visibility="Collapsed" />
                        <StackPanel x:Name="Categories" />
                    </StackPanel>
                </ScrollViewer>
            </controls:Bevel>
            <!-- the cards scroll in a sunken box, like the list on the left, so its edge shows where they are cut off -->
            <controls:Bevel Grid.Column="2" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
            <ScrollViewer x:Name="CardScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          ScrollChanged="CardsScrolled">
        <!-- one card per category, all on the page; SettingsPage.xaml.cs lists them on the left by their headings -->
        <StackPanel x:Name="Cards" Margin="8,8,8,0">
            <!-- Results -->
            <controls:Bevel Style="{StaticResource Card}" Margin="0,0,0,10" Tag="Results">
                <StackPanel>
                    <controls:Bevel Style="{StaticResource CardHeading}"><TextBlock Text="{t:Text Settings.Results}" /></controls:Bevel>
                    <controls:SettingGrid Margin="12,2,12,8">
                        <controls:SettingRow x:Name="CapRow" Label="{t:Text Settings.EditsListedPerRule}">
                            <TextBox x:Name="CapBox" Style="{StaticResource MonoBox}" Width="172" ToolTip="{t:Text Settings.CapBox.Tip}"
                                     LostKeyboardFocus="CapLeft" KeyDown="BoxKeyDown" />
                        </controls:SettingRow>
                    </controls:SettingGrid>
                </StackPanel>
            </controls:Bevel>

            <!-- Export -->
            <controls:Bevel Style="{StaticResource Card}" Margin="0,0,0,10" Tag="Export">
                <StackPanel>
                    <controls:Bevel Style="{StaticResource CardHeading}"><TextBlock Text="{t:Text Settings.Export}" /></controls:Bevel>
                    <controls:SettingGrid Margin="12,2,12,8">
                        <controls:SettingRow Label="{t:Text Settings.KeepSourceComments}" Note="{t:Text Settings.KeepSourceComments.Note}">
                            <CheckBox x:Name="CommentsSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.CommentsSwitch.Tip}" Click="SwitchClicked" Tag="keepComments" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.LineEndings}" Note="{t:Text Settings.LineEndings.Note}">
                            <ComboBox x:Name="LineEndChoice" MinWidth="144" ToolTip="{t:Text Settings.LineEndChoice.Tip}" SelectionChanged="ChoiceChanged" Tag="eol">
                                <ComboBoxItem Content="LF" Tag="lf" />
                                <ComboBoxItem Content="{t:Text Settings.CRLFWindows}" Tag="crlf" />
                                <ComboBoxItem Content="{t:Text Settings.SameAsSource}" Tag="keep" />
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.FilesToExport}" Note="{t:Text Settings.FilesToExport.Note}">
                            <ComboBox x:Name="ScopeChoice" MinWidth="144" ToolTip="{t:Text Settings.ScopeChoice.Tip}" SelectionChanged="ChoiceChanged" Tag="exportScope">
                                <ComboBoxItem Content="{t:Text Settings.ChangedFiles}" Tag="changed" />
                                <ComboBoxItem Content="{t:Text Settings.AllFilesThatAre}" Tag="all" />
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="DecimalsRow" Label="{t:Text Settings.DecimalPlaces}">
                            <TextBox x:Name="DecimalsBox" Style="{StaticResource MonoBox}" Width="172" ToolTip="{t:Text Settings.DecimalsBox.Tip}"
                                     LostKeyboardFocus="DecimalsLeft" KeyDown="BoxKeyDown" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.ConfirmBeforeRunExport}" Note="{t:Text Settings.ConfirmBeforeRunExport.Note}">
                            <CheckBox x:Name="ConfirmExportSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.ConfirmExportSwitch.Tip}" Click="SwitchClicked" Tag="confirmExport" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.BackUpOverwrittenFiles}" Note="{t:Text Settings.BackUpOverwrittenFiles.Note}">
                            <CheckBox x:Name="BackupSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.BackupSwitch.Tip}" Click="SwitchClicked" Tag="backupOverwritten" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.OpenTheFolderAfter}" Note="{t:Text Settings.OpenTheFolderAfter.Note}">
                            <CheckBox x:Name="OpenFolderSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.OpenFolderSwitch.Tip}" Click="SwitchClicked" Tag="openAfterExport" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.EditedWithEasyNDFComment}" Note="{t:Text Settings.EditedWithEasyNDFComment.Note}">
                            <CheckBox x:Name="StampSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.StampSwitch.Tip}" Click="SwitchClicked" Tag="stamp" />
                        </controls:SettingRow>
                    </controls:SettingGrid>
                </StackPanel>
            </controls:Bevel>

            <!-- Files -->
            <controls:Bevel Style="{StaticResource Card}" Margin="0,0,0,10" Tag="Files">
                <StackPanel>
                    <controls:Bevel Style="{StaticResource CardHeading}"><TextBlock Text="{t:Text Settings.Files}" /></controls:Bevel>
                    <controls:SettingGrid Margin="12,2,12,8">
                        <controls:SettingRow Label="{t:Text Settings.AddFolderLists}" Note="{t:Text Settings.AddFolderLists.Note}">
                            <ComboBox x:Name="FolderChoice" MinWidth="144" ToolTip="{t:Text Settings.FolderChoice.Tip}" SelectionChanged="ChoiceChanged" Tag="folderMode">
                                <ComboBoxItem Content="{t:Text Settings.AllNdfFiles}" Tag="all" />
                                <ComboBoxItem Content="{t:Text Settings.FilesWithAPreset}" Tag="matched" />
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.DuplicateFiles}" Note="{t:Text Settings.DuplicateFiles.Note}">
                            <ComboBox x:Name="DuplicateChoice" MinWidth="144" ToolTip="{t:Text Settings.DuplicateChoice.Tip}" SelectionChanged="ChoiceChanged" Tag="dupes">
                                <ComboBoxItem Content="{t:Text Settings.Ask}" Tag="ask" />
                                <ComboBoxItem Content="{t:Text Settings.Replace}" Tag="replace" />
                                <ComboBoxItem Content="{t:Text Settings.Skip}" Tag="skip" />
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.WrapTextInLists}" Note="{t:Text Settings.WrapTextInLists.Note}">
                            <CheckBox x:Name="WrapSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.WrapSwitch.Tip}" Click="SwitchClicked" Tag="wrapRows" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.AutoFitFileList}" Note="{t:Text Settings.AutoFitFileList.Note}">
                            <CheckBox x:Name="FitSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.FitSwitch.Tip}" Click="SwitchClicked" Tag="autoFit" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.AutoAssignPresetsBy}" Note="{t:Text Settings.AutoAssignPresetsBy.Note}">
                            <CheckBox x:Name="AssignSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.AssignSwitch.Tip}" Click="SwitchClicked" Tag="autoAssign" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.ReopenTheLastFiles}" Note="{t:Text Settings.ReopenTheLastFiles.Note}">
                            <CheckBox x:Name="SessionSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.SessionSwitch.Tip}" Click="SwitchClicked" Tag="restoreSession" />
                        </controls:SettingRow>
                    </controls:SettingGrid>
                </StackPanel>
            </controls:Bevel>

            <!-- Editing -->
            <controls:Bevel Style="{StaticResource Card}" Margin="0,0,0,10" Tag="Editing">
                <StackPanel>
                    <controls:Bevel Style="{StaticResource CardHeading}"><TextBlock Text="{t:Text Settings.Editing}" /></controls:Bevel>
                    <controls:SettingGrid Margin="12,2,12,8">
                        <controls:SettingRow Label="{t:Text Settings.ConfirmRuleDeletion}" Note="{t:Text Settings.ConfirmRuleDeletion.Note}">
                            <CheckBox x:Name="ConfirmSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.ConfirmSwitch.Tip}" Click="SwitchClicked" Tag="confirmDelete" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.UndoSteps}" Note="{t:Text Settings.UndoSteps.Note}">
                            <ComboBox x:Name="UndoChoice" MinWidth="144" ToolTip="{t:Text Settings.UndoChoice.Tip}" SelectionChanged="ChoiceChanged" Tag="undoSteps">
                                <ComboBoxItem Content="30" Tag="30" />
                                <ComboBoxItem Content="60" Tag="60" />
                                <ComboBoxItem Content="100" Tag="100" />
                                <ComboBoxItem Content="200" Tag="200" />
                                <ComboBoxItem Content="500" Tag="500" />
                            </ComboBox>
                        </controls:SettingRow>
                    </controls:SettingGrid>
                </StackPanel>
            </controls:Bevel>

            <!-- File Editor -->
            <controls:Bevel Style="{StaticResource Card}" Margin="0,0,0,10" Tag="FileEditor">
                <StackPanel>
                    <controls:Bevel Style="{StaticResource CardHeading}"><TextBlock Text="{t:Text Settings.FileEditor}" /></controls:Bevel>
                    <controls:SettingGrid Margin="12,2,12,8">
                        <controls:SettingRow Label="{t:Text Settings.TextSize}" Note="{t:Text Settings.TextSize.Note}">
                            <ComboBox x:Name="TextSizeChoice" MinWidth="144" ToolTip="{t:Text Settings.TextSizeChoice.Tip}" SelectionChanged="TextSizeChosen" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.LineNumbers}">
                            <CheckBox x:Name="LineNumbersSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.LineNumbersSwitch.Tip}" Click="SwitchClicked" Tag="lineNumbers" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.WordWrap}" Note="{t:Text Settings.WordWrap.Note}">
                            <CheckBox x:Name="WordWrapSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.WordWrapSwitch.Tip}" Click="SwitchClicked" Tag="wordWrap" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.ScopeLines}" Note="{t:Text Settings.ScopeLines.Note}">
                            <CheckBox x:Name="GuidesSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.GuidesSwitch.Tip}" Click="SwitchClicked" Tag="indentGuides" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.CloseBracketsAndQuotes}" Note="{t:Text Settings.CloseBracketsAndQuotes.Note}">
                            <CheckBox x:Name="PairsSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.PairsSwitch.Tip}" Click="SwitchClicked" Tag="autoPairs" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.ShowEverythingInThe}" Note="{t:Text Settings.ShowEverythingInThe.Note}">
                            <CheckBox x:Name="TreeAllSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.TreeAllSwitch.Tip}" Click="SwitchClicked" Tag="treeShowsAll" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.ReopenTheLastFile}" Note="{t:Text Settings.ReopenTheLastFile.Note}">
                            <CheckBox x:Name="ReopenFileSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.ReopenFileSwitch.Tip}" Click="SwitchClicked" Tag="reopenFile" />
                        </controls:SettingRow>
                    </controls:SettingGrid>
                </StackPanel>
            </controls:Bevel>

            <!-- Appearance -->
            <controls:Bevel Style="{StaticResource Card}" Margin="0,0,0,10" Tag="Appearance">
                <StackPanel>
                    <controls:Bevel Style="{StaticResource CardHeading}"><TextBlock Text="{t:Text Settings.Appearance}" /></controls:Bevel>
                    <controls:SettingGrid Margin="12,2,12,8">
                        <controls:SettingRow Label="{t:Text Settings.Theme}" Note="{t:Text Settings.Theme.Note}">
                            <ComboBox x:Name="ThemeChoice" MinWidth="144" ToolTip="{t:Text Settings.ThemeChoice.Tip}" SelectionChanged="ThemeChosen" />
                        </controls:SettingRow>
                        <controls:SettingRow x:Name="FontsRow" Label="{t:Text Settings.Fonts}" Note="{t:Text Settings.FontsRow.Note}">
                            <Button Content="{t:Text Settings.FontsButton}" ToolTip="{t:Text Settings.FontsButton.Tip}" Click="FontsClicked" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.BeveledEdges}" Note="{t:Text Settings.BeveledEdges.Note}">
                            <CheckBox x:Name="BevelSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.BevelSwitch.Tip}" Click="BevelClicked" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.InterfaceSize}" Note="{t:Text Settings.InterfaceSize.Note}">
                            <ComboBox x:Name="ScaleChoice" MinWidth="144" ToolTip="{t:Text Settings.ScaleChoice.Tip}" SelectionChanged="ChoiceChanged" Tag="uiScale">
                                <ComboBoxItem Content="90%" Tag="90" />
                                <ComboBoxItem Content="100%" Tag="100" />
                                <ComboBoxItem Content="110%" Tag="110" />
                                <ComboBoxItem Content="125%" Tag="125" />
                                <ComboBoxItem Content="150%" Tag="150" />
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.Tooltips}" Note="{t:Text Settings.Tooltips.Note}">
                            <CheckBox x:Name="TooltipsSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.TooltipsSwitch.Tip}" Click="SwitchClicked" Tag="tooltips" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.RememberTheWindow}" Note="{t:Text Settings.RememberTheWindow.Note}">
                            <CheckBox x:Name="WindowSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.WindowSwitch.Tip}" Click="SwitchClicked" Tag="rememberWindow" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.TreadScrollbars}" Note="{t:Text Settings.TreadScrollbars.Note}">
                            <CheckBox x:Name="TreadSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.TreadSwitch.Tip}" Click="TreadClicked" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.PanesGrowWithThe}" Note="{t:Text Settings.PanesGrowWithThe.Note}">
                            <CheckBox x:Name="PanesScaleSwitch" Style="{StaticResource Toggle}" ToolTip="{t:Text Settings.PanesScaleSwitch.Tip}" Click="SwitchClicked" Tag="panesScale" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.ColumnWidths}" Note="{t:Text Settings.ColumnWidths.Note}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{t:Text Settings.ResetColumnWidths}" ToolTip="{t:Text Settings.ResetColumnWidths.Tip}" Click="ResetColumnsClicked" />
                                <TextBlock x:Name="ColumnsNote" Style="{StaticResource Note}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SettingRow>
                    </controls:SettingGrid>
                    <!-- the Theme Designer (the HTML app's .tdz): under a line, with a bold heading of its own -->
                    <Border x:Name="DesignerBlock" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource line}">
                        <StackPanel>
                            <TextBlock Text="{t:Text Settings.ThemeDesigner}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ink}" Margin="12,12,12,-4" />
                            <pages:ThemeDesigner x:Name="Designer" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:Bevel>

            <!-- Language: the language of the app's texts, and the packs that add languages (SettingsPage.Languages.cs) -->
            <controls:Bevel Style="{StaticResource Card}" Margin="0,0,0,10" Tag="Language">
                <StackPanel>
                    <controls:Bevel Style="{StaticResource CardHeading}"><TextBlock Text="{t:Text Settings.Language}" /></controls:Bevel>
                    <controls:SettingGrid Margin="12,2,12,8">
                        <controls:SettingRow Label="{t:Text Settings.Language}" Note="{t:Text Settings.LanguageChoice.Note}">
                            <ComboBox x:Name="LanguageChoice" MinWidth="144" ToolTip="{t:Text Settings.LanguageChoice.Tip}" SelectionChanged="LanguageChosen" />
                        </controls:SettingRow>
                        <controls:SettingRow Label="{t:Text Settings.LanguagePacks}" Note="{t:Text Settings.LanguagePacks.Note}">
                            <controls:SnappedRow Gap="6">
                                <Button Content="{t:Text Settings.ImportLanguage}" ToolTip="{t:Text Settings.ImportLanguage.Tip}" Click="ImportLanguageClicked" />
                                <Button Content="{t:Text Settings.ExportLanguage}" ToolTip="{t:Text Settings.ExportLanguage.Tip}" Click="ExportLanguageClicked" />
                                <Button x:Name="RemoveLanguageButton" Content="{t:Text Settings.RemoveLanguage}" ToolTip="{t:Text Settings.RemoveLanguage.Tip}" Click="RemoveLanguageClicked" />
                            </controls:SnappedRow>
                        </controls:SettingRow>
                    </controls:SettingGrid>
                    <TextBlock x:Name="LanguageNote" Style="{StaticResource Note}" Margin="12,0,12,8" Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
            </controls:Bevel>

            <!-- Data -->
            <controls:Bevel Style="{StaticResource Card}" Margin="0,0,0,10" Tag="Data">
                <StackPanel>
                    <controls:Bevel Style="{StaticResource CardHeading}"><TextBlock Text="{t:Text Settings.Data}" /></controls:Bevel>
                    <controls:SettingGrid Margin="12,2,12,8">
                        <controls:SettingRow Note="{t:Text Settings.OneFileWithAll.Note}">
                            <controls:SnappedRow Gap="6">
                                <Button Content="{t:Text Settings.BackUpAllMods}" ToolTip="{t:Text Settings.BackUpAllMods.Tip}" Click="BackupClicked" />
                                <Button Content="{t:Text Settings.RestoreBackup}" ToolTip="{t:Text Settings.RestoreBackup.Tip}" Click="RestoreClicked" />
                            </controls:SnappedRow>
                        </controls:SettingRow>
                        <controls:SettingRow Note="{t:Text Settings.ResetSettingsKeepsYour.Note}">
                            <controls:SnappedRow Gap="6">
                                <Button Content="{t:Text Settings.ResetSettings}" ToolTip="{t:Text Settings.ResetSettings.Tip}" Click="ResetClicked" />
                                <Button Content="{t:Text Settings.ClearAllData}" ToolTip="{t:Text Settings.ClearAllData.Tip}" Click="ClearClicked" />
                            </controls:SnappedRow>
                        </controls:SettingRow>
                    </controls:SettingGrid>
                    <TextBlock x:Name="DataNote" Style="{StaticResource Note}" Margin="12,0,12,8" />
                </StackPanel>
            </controls:Bevel>
        </StackPanel>
            </ScrollViewer>
            </controls:Bevel>
        </Grid>
    </DockPanel>
</UserControl>
