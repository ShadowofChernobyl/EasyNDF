<!--
  The Divisions tab: the divisions of the source the Units tab has read. On the left the divisions, by side and nation;
  on the right the one chosen, its units as cards grouped by category (as on the Units tab) or as a table, and the
  Division pane beside or below. Its text is in the theme's ink, which the parts built in code take.
  DivisionsPage.xaml.cs fills it; the parts that show a division are in the Divisions folder.
-->
<UserControl x:Class="EasyNdf.App.Pages.DivisionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:units="clr-namespace:EasyNdf.App.Units"
             Foreground="{DynamicResource ink}">
    <UserControl.Resources>
        <!-- a sunken box that scrolls -->
        <Style x:Key="SunkenBox" TargetType="controls:Bevel">
            <Setter Property="TopLeft" Value="{DynamicResource lo}" />
            <Setter Property="BottomRight" Value="{DynamicResource hi}" />
            <Setter Property="Background" Value="{DynamicResource well}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- the left column: the source (the same list as on the Files and Units tabs), finding a division, then the divisions -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <controls:Bevel Style="{StaticResource Heading}"><TextBlock Text="{t:Text Units.Source}" /></controls:Bevel>
                <units:SourceChoice x:Name="SourceChoice" />
                <TextBlock x:Name="WhereText" FontSize="11.5" Foreground="{DynamicResource muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <controls:Bevel Style="{StaticResource Heading}"><TextBlock Text="{t:Text Divisions.Find}" /></controls:Bevel>
                <TextBox x:Name="SearchBox" Tag="{t:Text Divisions.SearchBox.Hint}" ToolTip="{t:Text Divisions.SearchBox.Tip}" TextChanged="SearchChanged" />
                <StackPanel x:Name="SideChoices" Orientation="Horizontal" Margin="0,6,0,0" />
            </StackPanel>
            <controls:Bevel DockPanel.Dock="Top" Style="{StaticResource Heading}">
                <DockPanel>
                    <!-- + makes a new division in the open mod -->
                    <Button x:Name="NewDivisionButton" DockPanel.Dock="Right" Style="{StaticResource HeadingButton}" Content="+" FontWeight="Bold"
                            ToolTip="{t:Text Divisions.NewDivision.Tip}" AutomationProperties.Name="{t:Text Divisions.NewDivision}" Click="NewDivisionClicked" />
                    <TextBlock Text="{t:Text Divisions.List}" VerticalAlignment="Center" />
                </DockPanel>
            </controls:Bevel>
            <controls:Bevel Style="{StaticResource SunkenBox}" MinHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="DivisionList" Margin="0,2" />
                </ScrollViewer>
            </controls:Bevel>
        </DockPanel>

        <!-- the right column -->
        <DockPanel Grid.Column="2">
            <controls:Bevel DockPanel.Dock="Top" Style="{StaticResource Heading}">
                <controls:FlexRow Gap="8" LineGap="4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" controls:FlexRow.Grow="1">
                        <TextBlock x:Name="TitleText" VerticalAlignment="Center" />
                        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource muted}" FontWeight="Normal" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- where the divisions come from, and which mod their changes are saved in: the two can differ -->
                    <TextBlock x:Name="SavedInText" Foreground="{DynamicResource muted}" FontWeight="Normal" VerticalAlignment="Center" />
                </controls:FlexRow>
            </controls:Bevel>

            <!-- what the view shows: how to use it, and how many units -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource muted}" Margin="12,0,0,0" />
                <TextBlock x:Name="Footnote" Style="{StaticResource Note}" Text="{t:Text Divisions.Footnote}" />
            </DockPanel>

            <Grid>
                <controls:PanePair x:Name="Panes" Key="divisions" DefaultBeside="330" DefaultBelow="300"
                                   FoldedIcon="M 1.5,1.5 H 12.5 V 12.5 H 1.5 Z M 1.5,6 H 12.5 M 4,8.5 H 10 M 4,10.5 H 8">
                    <controls:PanePair.Main>
                        <DockPanel>
                            <!-- the category tabs, with a line under them; the Division pane's button waits at their right when it is folded beside -->
                            <controls:Bevel DockPanel.Dock="Top" BottomRight="{DynamicResource line}" Edges="0,0,0,1">
                                <DockPanel>
                                    <ContentControl x:Name="PaneSlot" DockPanel.Dock="Right" Focusable="False" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                    <!-- + Add Units…, then Cards and Table, at the list's top right -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,3">
                                        <!-- Cards and Table as icons, as on the Units tab; their names are for screen readers -->
                                        <ToggleButton x:Name="CardsButton" Style="{StaticResource PressedToggle}" Padding="5,4" AutomationProperties.Name="{t:Text Divisions.Cards}"
                                                      ToolTip="{t:Text Divisions.Cards.Tip}" Click="ViewClicked">
                                            <controls:ViewIcon Shape="Cards" />
                                        </ToggleButton>
                                        <ToggleButton x:Name="TableButton" Style="{StaticResource PressedToggle}" Padding="5,4" Margin="-1,0,0,0" AutomationProperties.Name="{t:Text Divisions.Table}"
                                                      ToolTip="{t:Text Divisions.Table.Tip}" Click="ViewClicked">
                                            <controls:ViewIcon Shape="Table" />
                                        </ToggleButton>
                                    </StackPanel>
                                    <Button x:Name="AddUnitsButton" DockPanel.Dock="Right" Style="{StaticResource HeadingButton}" VerticalAlignment="Bottom" Margin="8,0,0,3"
                                            Content="{t:Text Units.AddUnits}" ToolTip="{t:Text Divisions.AddUnits.Tip}" Click="AddUnitsClicked" />
                                    <WrapPanel x:Name="FactoryTabs" VerticalAlignment="Bottom" />
                                </DockPanel>
                            </controls:Bevel>
                            <controls:Bevel Style="{StaticResource SunkenBox}">
                                <Grid>
                                    <!-- the Cards view: the units by category, as tiles -->
                                    <ScrollViewer x:Name="ViewScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                                  MouseLeftButtonUp="UnitClicked" MouseRightButtonUp="UnitRightClicked">
                                        <ContentControl x:Name="ViewContent" Focusable="False" />
                                    </ScrollViewer>
                                    <!-- the Table view: the Units tab's table, with the division's own columns -->
                                    <units:UnitTableList x:Name="TableList" WidthsKey="divisionColumns" Visibility="Collapsed"
                                                         MouseLeftButtonUp="UnitClicked" MouseRightButtonUp="UnitRightClicked" />
                                </Grid>
                            </controls:Bevel>
                        </DockPanel>
                    </controls:PanePair.Main>
                    <controls:PanePair.Second>
                        <controls:Bevel Style="{StaticResource SunkenBox}">
                            <DockPanel>
                                <!-- what the open mod does to the division, at the pane's foot, so the boxes above never move -->
                                <TextBlock x:Name="ModNote" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="10,4,10,6" TextWrapping="Wrap"
                                           Foreground="{DynamicResource accent}" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PaneScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ContentControl x:Name="PaneContent" Focusable="False" />
                                </ScrollViewer>
                            </DockPanel>
                        </controls:Bevel>
                    </controls:PanePair.Second>
                </controls:PanePair>

                <!-- instead of the views: nothing read yet, or no division chosen -->
                <controls:Bevel x:Name="MessageArea" Style="{StaticResource SunkenBox}" Visibility="Collapsed">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="MessageText" Foreground="{DynamicResource muted}" TextWrapping="Wrap" />
                        <!-- while the source is read: the Units tab's loading bar, followed here, and the step it is on -->
                        <controls:BlockBar x:Name="ReadingBar" Margin="0,8,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="ReadingStep" FontSize="12" Foreground="{DynamicResource muted}" Margin="0,5,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </controls:Bevel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
