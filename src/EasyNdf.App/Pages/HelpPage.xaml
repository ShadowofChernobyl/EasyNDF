<!--
  The Help tab (the HTML app's #pageHelp and its wiki): the list of pages with a search box on the left, and the page on
  the right with Back, Forward, its group, its title and Previous and Next. The list and the page scroll on their own.
  HelpPage.xaml.cs fills it; Help/WikiRenderer.cs draws each page.
-->
<UserControl x:Class="EasyNdf.App.Pages.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls">
    <!-- #wiki: at most 72rem wide, in the middle of the tab -->
    <Grid x:Name="Wiki" MaxWidth="1152" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- #wkNav: the list fills the tab's height; the search box scrolls with it, as in the browser -->
        <controls:Bevel x:Name="Nav" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
            <ScrollViewer x:Name="NavScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="8">
                    <TextBox x:Name="Find" Margin="0,0,0,8" Tag="Search help" ToolTip="Search help"
                             TextChanged="FindChanged" KeyDown="FindKeyDown" />
                    <StackPanel x:Name="PageList" />
                </StackPanel>
            </ScrollViewer>
        </controls:Bevel>

        <!-- #wkPage: Back, Forward and Welcome window stay put; the page under them scrolls -->
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="‹" ToolTip="Back" Click="BackClicked" VerticalAlignment="Center" />
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="›" ToolTip="Forward" Click="ForwardClicked" Margin="6,0,0,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Welcome window" ToolTip="Open the welcome window" HorizontalAlignment="Right" Click="WelcomeClicked" />
            </DockPanel>
            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <!-- #wkCrumb: the page's group, a link to its first page -->
                    <TextBlock HorizontalAlignment="Left" Margin="0,2,0,2" FontSize="11.5" LineHeight="16.675" LineStackingStrategy="BlockLineHeight">
                        <Hyperlink x:Name="Crumb" Style="{StaticResource CrumbLink}" Click="CrumbClicked" ToolTip="The first page of this group"><Run x:Name="CrumbText" /></Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="PageTitle" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ink}" TextWrapping="Wrap"
                               LineHeight="24.65" LineStackingStrategy="BlockLineHeight" />
                    <!-- the page's text and Previous and Next are at most 46rem wide -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="736" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ContentControl x:Name="Body" Focusable="False" />
                            <!-- .wkpager: Previous and Next -->
                            <DockPanel x:Name="Pager" LastChildFill="False">
                                <Button x:Name="PreviousButton" ToolTip="Previous page" Click="PagerClicked" />
                                <Button x:Name="NextButton" ToolTip="Next page" DockPanel.Dock="Right" Click="PagerClicked" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
