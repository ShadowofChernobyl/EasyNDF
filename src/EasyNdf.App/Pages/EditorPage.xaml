<!--
  The Editor tab (the HTML app's #pageEditor): a file from the Files tab, or one opened on its own, in an editor with
  NDF colours. EditorPage.xaml.cs opens, keeps and saves the file; Editor/ holds the editor's colouring, line numbers
  and line height. The descriptor viewer under it comes with a later step.
-->
<UserControl x:Class="EasyNdf.App.Pages.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:editor="clr-namespace:EasyNdf.App.Editor">
    <UserControl.Resources>
        <!-- the Fold all and Unfold all icons: a square, with a minus or a plus in it; 2 pixels above and below, as button.icon svg has -->
        <Geometry x:Key="FoldAllIcon">M 1.5,1.5 H 12.5 V 12.5 H 1.5 Z M 4,7 H 10</Geometry>
        <Geometry x:Key="UnfoldAllIcon">M 1.5,1.5 H 12.5 V 12.5 H 1.5 Z M 4,7 H 10 M 7,4 V 10</Geometry>

        <!-- #dvList and #dvProps: lists in the code font, 12 pixels on 17-pixel lines; only the rows in sight are made -->
        <Style x:Key="DescriptorList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextBlock.LineHeight" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource ink}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DescriptorTree" TargetType="ListBox" BasedOn="{StaticResource DescriptorList}" />
        <Style x:Key="DescriptorProperties" TargetType="ListBox" BasedOn="{StaticResource DescriptorList}" />

        <!-- .dvi: a row of the tree: the arrow, the name, its type dimmed, and another file it is in; chosen, it is marked at its left -->
        <DataTemplate DataType="{x:Type editor:TreeItem}">
            <Grid x:Name="Row" Height="17" Background="Transparent">
                <Border x:Name="Mark" Width="2" HorizontalAlignment="Left" Background="{DynamicResource accent}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                    <TextBlock x:Name="Arrow" Tag="arrow" Text="{Binding Arrow}" Width="11" TextAlignment="Center" Foreground="{DynamicResource muted}" Background="Transparent" />
                    <TextBlock x:Name="Label" Text="{Binding Label}" Margin="6,0,0,0" Foreground="{DynamicResource s-name}" />
                    <TextBlock x:Name="Sub" Text="{Binding Sub}" Margin="6,0,0,0" Foreground="{DynamicResource muted}" />
                    <TextBlock x:Name="FileTag" Text="{Binding FileTag}" Margin="6,0,0,0" Foreground="{DynamicResource s-string}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource sel}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource sel}" />
                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFile}" Value="True">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource s-string}" />
                </DataTrigger>
                <Trigger SourceName="Arrow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource accent}" />
                </Trigger>
                <DataTrigger Binding="{Binding Sub}" Value="">
                    <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FileTag}" Value="">
                    <Setter TargetName="FileTag" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- input.dvv: a value that can be typed over, 17 pixels tall in a border of the line colour; read-only, it shows no box -->
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ink}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ink}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource accent}" />
            <Setter Property="Background" Value="{DynamicResource well}" />
            <Setter Property="BorderBrush" Value="{DynamicResource line}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Height" Value="17" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="TextBlock.LineHeight" Value="15" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Edge" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <!-- WPF puts the text 2 pixels further in than the padding; the margin takes that back -->
                            <ScrollViewer x:Name="PART_ContentHost" Margin="-2,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource muted}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource accent}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="bad">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource warn}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Edge" Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .dvrow with .dvtog: an object or a list, its arrow in the space before it -->
        <DataTemplate DataType="{x:Type editor:ObjectOrListItem}">
            <Grid x:Name="Row" MinHeight="19" Background="Transparent">
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                    <TextBlock x:Name="Arrow" Tag="toggle" Text="{Binding Arrow}" ToolTip="{Binding ArrowTip}" Width="12" Margin="-14,0,0,0" TextAlignment="Center"
                               Foreground="{DynamicResource muted}" Background="Transparent" Cursor="Hand" />
                    <TextBlock Text="{Binding Key}" Margin="6,0,0,0" Foreground="{DynamicResource s-field}" />
                    <TextBlock Text="{Binding Title}" Margin="6,0,0,0" Foreground="{DynamicResource s-type}" />
                    <TextBlock x:Name="Hidden" Text="{Binding Hidden}" Margin="6,0,0,0" Foreground="{DynamicResource muted}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource sel}" />
                </Trigger>
                <Trigger SourceName="Arrow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource accent}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsShut}" Value="False">
                    <Setter TargetName="Hidden" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- .dvrow with input.dvv: a value's key, at most 55% of the row, then the value to the row's end -->
        <DataTemplate DataType="{x:Type editor:ValueItem}">
            <Grid x:Name="Row" MinHeight="19" Background="Transparent">
                <DockPanel Margin="{Binding Indent}" VerticalAlignment="Center" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" MaxWidth="{Binding KeyWidth}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource s-field}" VerticalAlignment="Center" />
                    <TextBox Style="{StaticResource ValueBox}" Margin="6,0,0,0" Text="{Binding Shown, Mode=OneTime}" IsReadOnly="{Binding IsReadOnly}" ToolTip="{Binding Tip}"
                             KeyDown="ValueKeyDown" LostKeyboardFocus="ValueLeft" TextChanged="ValueTyped" />
                </DockPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource sel}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- .dvuse: "Used by" and how many, with a line under it -->
        <DataTemplate DataType="{x:Type editor:UsedByItem}">
            <Border x:Name="Row" MinHeight="19" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource line}" Background="Transparent"
                    ToolTip="Every descriptor in the read files that has this one among its values. A change made here is a change for all of them.">
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                    <TextBlock x:Name="Arrow" Tag="users" Text="{Binding Arrow}" Width="12" Margin="-14,0,0,0" TextAlignment="Center" Foreground="{DynamicResource muted}" Background="Transparent" Cursor="Hand" />
                    <TextBlock Text="Used by" Margin="6,0,0,0" Foreground="{DynamicResource s-field}" />
                    <TextBlock Text="{Binding Text}" Margin="6,0,0,0" Foreground="{DynamicResource muted}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource sel}" />
                </Trigger>
                <Trigger SourceName="Arrow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource accent}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- .dvi.dvu: a descriptor that uses this one -->
        <DataTemplate DataType="{x:Type editor:UserItem}">
            <Grid x:Name="Row" Height="17" Background="Transparent" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                    <TextBlock Text="{Binding User.Name}" Foreground="{DynamicResource s-name}" />
                    <TextBlock Text="{Binding Type}" Margin="8,0,0,0" Foreground="{DynamicResource muted}" />
                    <TextBlock Text="{Binding FileTag}" Margin="8,0,0,0" Foreground="{DynamicResource s-string}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource sel}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- p.note and p.empty in the list -->
        <DataTemplate DataType="{x:Type editor:NoteItem}">
            <TextBlock x:Name="Text" Text="{Binding Text}" Margin="{Binding Space}" Foreground="{DynamicResource muted}" TextWrapping="Wrap"
                       FontFamily="{DynamicResource ui-font}" FontSize="12.5" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- the bars stay at the top; the File Editor and the descriptor viewer share the rest of the window, beside or below -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <!-- .bar: the file, Open file..., and at the right what can be done with the file -->
            <controls:FlexRow Gap="6" LineGap="6" Margin="0,0,0,8">
                <!-- #edPick: 24rem to start, growing with the room left, from 12rem to 44rem -->
                <ComboBox x:Name="FilePick" controls:FlexRow.Grow="1" controls:FlexRow.Basis="384" MinWidth="192" MaxWidth="704"
                          ToolTip="Open a file from the Files tab" SelectionChanged="FilePicked" PreviewMouseRightButtonUp="FilePickRightClicked" />
                <Button Content="Open file..." ToolTip="Open a file without adding it to the Files tab" Click="OpenFileClicked" />
                <!-- the find bar stays out of the way until it is asked for, as in Sublime Text -->
                <ToggleButton x:Name="FindToggle" Style="{StaticResource PressedToggle}" Content="Find" Click="FindToggleClicked"
                              ToolTip="Find, replace, go to line and search all files (Ctrl+F)" />
                <!-- .grow: the room left, shared with the file's dropdown -->
                <Border controls:FlexRow.Grow="1" controls:FlexRow.Basis="0" />
                <Button x:Name="DiscardButton" Content="Discard changes" ToolTip="Discard your edits" Click="DiscardClicked" />
                <!-- button.swap: as wide as the wider of its two texts -->
                <Button x:Name="ExportButton" ToolTip="Toggle source and export" IsEnabled="False" Click="ExportClicked">
                    <Grid>
                        <TextBlock x:Name="ShowExportText" Text="Show export" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ShowSourceText" Text="Show source" HorizontalAlignment="Center" Visibility="Hidden" />
                    </Grid>
                </Button>
                <ToggleButton x:Name="ChangesButton" Style="{StaticResource PressedToggle}" Content="Changes only" ToolTip="Show only the lines the export changes"
                              IsEnabled="False" Click="ChangesClicked" />
                <Button x:Name="UseButton" Content="Use in file list" ToolTip="Run the rules on the edited text" Click="UseClicked" />
                <Button x:Name="SaveButton" Content="Save as..." ToolTip="Save the text as a file" Click="SaveClicked" />
                <Button Style="{StaticResource HelpButton}" controls:QuickHelp.Page="tab-editor" />
            </controls:FlexRow>

            <!-- .bar: Find, Replace, Go to line and Search all files; shown by Find or Ctrl+F, hidden by × or Escape -->
            <controls:FlexRow x:Name="FindBar" Gap="6" LineGap="6" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBox x:Name="FindBox" Width="224" Tag="Find" ToolTip="Enter: next match. Shift+Enter: previous" IsEnabled="False" KeyDown="FindKeyDown" />
                <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Content="&#x2191;" ToolTip="Previous match (Shift+Enter)" IsEnabled="False" Click="PreviousClicked" />
                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#x2193;" ToolTip="Next match (Enter)" IsEnabled="False" Click="NextClicked" />
                <TextBox x:Name="ReplaceBox" Width="224" Tag="Replace with" ToolTip="Replacement text. Enter replaces and finds next" IsEnabled="False" KeyDown="ReplaceKeyDown" />
                <Button x:Name="ReplaceButton" Content="Replace" ToolTip="Replace and find next" IsEnabled="False" Click="ReplaceClicked" />
                <Button x:Name="ReplaceAllButton" Content="Replace all" ToolTip="Replace all matches" IsEnabled="False" Click="ReplaceAllClicked" />
                <controls:Bevel Style="{StaticResource BarSeparator}" />
                <TextBox x:Name="GoBox" Width="104" Tag="Go to line" ToolTip="Line number, then Enter" IsEnabled="False" KeyDown="GoKeyDown" />
                <controls:Bevel Style="{StaticResource BarSeparator}" />
                <TextBox x:Name="SearchAllBox" Width="192" Tag="Search all files"
                         ToolTip="Text to find in every file on the Files tab. Enter searches" KeyDown="SearchAllKeyDown" />
                <Button Content="Search" ToolTip="Search every file on the Files tab" Click="SearchAllClicked" />
                <Button Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="Close the find bar (Escape)" Click="CloseFindBarClicked" />
            </controls:FlexRow>

            <!-- #edAllWrap: what Search all files found: a note and ×, then the lines found, in a box that can be made taller -->
            <StackPanel x:Name="SearchResults" Visibility="Collapsed" Margin="0,0,0,6">
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xD7;" ToolTip="Close the results" Margin="6,0,0,0" Click="CloseResultsClicked" />
                    <TextBlock x:Name="SearchNote" Style="{StaticResource Note}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <!-- #edAllBox: 13rem tall, from 2.5rem to 75% of the window; sunken; 4 by 6 pixels in -->
                <Grid x:Name="ResultsArea">
                    <controls:Bevel x:Name="ResultsBox" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}"
                                    Height="208" MinHeight="40" PreviewMouseRightButtonUp="ResultsRightClicked">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl x:Name="ResultList" Margin="6,4" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- .hitrow: the file, the line number and the line, 10 pixels apart -->
                                        <Border x:Name="Row" Padding="4,1" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ResultClicked">
                                            <StackPanel Orientation="Horizontal" TextBlock.FontFamily="{DynamicResource mono}" TextBlock.FontSize="12"
                                                        TextBlock.LineHeight="17.390625" TextBlock.LineStackingStrategy="BlockLineHeight">
                                                <TextBlock Text="{Binding File}" Foreground="{DynamicResource accent}" />
                                                <TextBlock Text="{Binding Number}" Foreground="{DynamicResource muted}" MinWidth="{Binding NumberWidth}" TextAlignment="Right" Margin="10,0" />
                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource ink}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource hover}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </controls:Bevel>
                    <controls:ResizeCorner Target="{x:Reference ResultsBox}" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <controls:PanePair x:Name="Panes" Key="editor" SecondTitle="Descriptors" FoldedAtFirst="True" DefaultBeside="600" DefaultBelow="300">
            <controls:PanePair.Main>
                <DockPanel>
                <!-- .fhrow: the File Editor heading, the note about the file, and Fold all and Unfold all, on a line -->
                <controls:Bevel DockPanel.Dock="Top" Edges="0,0,0,1" BottomRight="{DynamicResource line}" Padding="0,0,0,3" Margin="0,0,0,5">
                    <DockPanel>
                        <!-- level with the middle of the row, which grows when the note wraps -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FoldAllButton" Style="{StaticResource IconButton}" ToolTip="Fold all" Margin="0,0,6,0" Click="FoldAllClicked">
                                <Path Data="{StaticResource FoldAllIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="14" Height="14" Margin="0,2" />
                            </Button>
                            <Button x:Name="UnfoldAllButton" Style="{StaticResource IconButton}" ToolTip="Unfold all" Click="UnfoldAllClicked">
                                <Path Data="{StaticResource UnfoldAllIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="14" Height="14" Margin="0,2" />
                            </Button>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="File Editor" FontWeight="Bold" Foreground="{DynamicResource accent}" VerticalAlignment="Center" />
                        <TextBlock x:Name="Note" Style="{StaticResource Note}" Margin="6,0,6,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </controls:Bevel>
                <!-- #edBox: a sunken box that fills the pane -->
                <Grid x:Name="EditorArea">
                    <controls:Bevel x:Name="EditorBox" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                        <DockPanel>
                            <!-- the status strip: the caret's line and column, and the text size; shown with the text -->
                            <ContentControl x:Name="StripHolder" DockPanel.Dock="Bottom" Focusable="False" Visibility="{Binding Visibility, ElementName=Text}" />
                            <Grid>
                            <TextBlock x:Name="EmptyText" Foreground="{DynamicResource muted}" Margin="10" Text="Choose a file above, or double-click one on the Files tab." />
                            <avalon:TextEditor x:Name="Text" Visibility="Collapsed" FontFamily="{DynamicResource mono}" FontSize="12"
                                               Background="{DynamicResource well}" Foreground="{DynamicResource ink}"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                               ToolTip="File text. Tab inserts four spaces. Ctrl+scroll changes the text size" />
                            </Grid>
                        </DockPanel>
                    </controls:Bevel>
                </Grid>
                </DockPanel>
            </controls:PanePair.Main>
            <controls:PanePair.Second>
                <!-- the descriptor viewer (EditorPage.Descriptors.cs): what it shows and how to use it, then the tree and the properties -->
                <DockPanel>
                    <TextBlock x:Name="DescriptorNote" DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,8" />
                    <!-- #dvBox: the tree, a 9-pixel bar that shares the width between them, and the properties; it fills the pane -->
                    <Grid x:Name="DescriptorBox" SizeChanged="DescriptorBoxResized">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TreeColumn" Width="*" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition x:Name="PropertiesColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- .dvl: the descriptor tree, sunken -->
                        <controls:Bevel Grid.Column="0" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                            <DockPanel>
                                <!-- .dvbar: This file and All files, the name filter with the property filter, and Scan all -->
                                <controls:Bevel DockPanel.Dock="Top" Edges="0,0,0,1" BottomRight="{DynamicResource line}" Padding="4,3" MinHeight="27">
                                    <controls:FlexRow Gap="4" LineGap="4" VerticalAlignment="Center">
                                        <ToggleButton x:Name="ModeOneButton" Style="{StaticResource SmallChoice}" IsChecked="True" ToolTip="List the descriptors of the file in the editor" Click="ModeOneClicked">
                                            <TextBlock x:Name="ModeOneText" Text="This file" />
                                        </ToggleButton>
                                        <ToggleButton x:Name="ModeAllButton" Style="{StaticResource SmallChoice}" Content="All files" ToolTip="List the chains of descriptors across the files that have been read" Click="ModeAllClicked" />
                                        <!-- .dvfg: the filter box, and the property filter's button joined to its right -->
                                        <DockPanel controls:FlexRow.Grow="1" controls:FlexRow.Basis="96" MinWidth="64">
                                            <!-- #dvFilt: the funnel, and how many conditions are on; pressed in while the filter is on -->
                                            <ToggleButton x:Name="FilterButton" DockPanel.Dock="Right" Style="{StaticResource PressedToggle}" Padding="6,0" FontSize="12"
                                                          TextBlock.LineHeight="18" ToolTip="Filter by property" Click="FilterClicked">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M 1,2 H 11 L 7.2,6.6 V 10.5 L 4.8,9.3 V 6.6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                          StrokeThickness="1.2" StrokeLineJoin="Round" Width="12" Height="12" Margin="0,3" />
                                                    <TextBlock x:Name="FilterBadge" FontSize="10.5" FontWeight="Bold" Margin="3,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <TextBox x:Name="DescriptorFind" Tag="Filter by name or type" FontSize="12" Padding="5,0" TextBlock.LineHeight="18"
                                                     ToolTip="Filter the descriptor list" TextChanged="DescriptorFindChanged" />
                                        </DockPanel>
                                        <Button x:Name="ScanButton" Style="{StaticResource SmallButton}" Content="Scan all" ToolTip="Read every file on the Files tab, to follow descriptors from one file to another" Click="ScanClicked" />
                                    </controls:FlexRow>
                                </controls:Bevel>
                                <!-- #dvList: the tree, 17 pixels a row; only the rows in sight are made -->
                                <ListBox x:Name="TreeList" Style="{StaticResource DescriptorTree}"
                                         ToolTip="Click: open or close, and list properties. Double-click or Alt+click: show in the text. Arrows move (Shift: five rows), Right opens, Left closes, Enter shows in the text."
                                         PreviewMouseLeftButtonDown="TreeMouseDown" PreviewKeyDown="TreeKeyDown" PreviewMouseRightButtonUp="TreeRightClicked" />
                            </DockPanel>
                        </controls:Bevel>

                        <!-- #dvSplit: drag to share the width; double-click shares it evenly again -->
                        <controls:SplitBar x:Name="DescriptorSplit" Grid.Column="1" ToolTip="Drag to resize. Double-click to reset." />

                        <!-- .dvr: the chosen descriptor's properties, sunken -->
                        <controls:Bevel Grid.Column="2" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource well}">
                            <DockPanel>
                                <!-- .dvtop: its name and type, and whether its values can be changed -->
                                <controls:Bevel DockPanel.Dock="Top" Edges="0,0,0,1" BottomRight="{DynamicResource line}" MinHeight="27">
                                    <DockPanel Margin="0,0,4,0">
                                        <TextBlock x:Name="DescriptorState" DockPanel.Dock="Right" Foreground="{DynamicResource muted}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="DescriptorHead" FontFamily="{DynamicResource mono}" FontSize="12" TextBlock.LineHeight="17" Padding="6,3" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </controls:Bevel>
                                <!-- #dvProps: a row for each property, at every depth -->
                                <ListBox x:Name="PropertyList" Style="{StaticResource DescriptorProperties}" PreviewMouseLeftButtonDown="PropertiesMouseDown" PreviewMouseRightButtonUp="PropertiesRightClicked" />
                            </DockPanel>
                        </controls:Bevel>
                    </Grid>
                </DockPanel>
            </controls:PanePair.Second>
        </controls:PanePair>
    </DockPanel>
</UserControl>
