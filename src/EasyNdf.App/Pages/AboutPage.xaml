<!--
  The About tab (the HTML app's #pageAbout): Change log, License and Support on Ko-fi above the text of Help/about.html, which
  AboutPage.xaml.cs draws, and which scrolls under them.
-->
<UserControl x:Class="EasyNdf.App.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EasyNdf.App.Text"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls">
    <!-- the buttons stay put; the text under them scrolls -->
    <DockPanel>
        <!-- .helpmode: the buttons in the middle, 7rem wide at least -->
        <controls:SnappedRow DockPanel.Dock="Top" Gap="6" HorizontalAlignment="Center" Margin="0,2,0,0">
            <Button x:Name="ChangeLogButton" Content="{t:Text About.ChangeLog}" MinWidth="112" ToolTip="{t:Text About.ChangeLog.Tip}" Click="ChangeLogClicked" />
            <Button Content="{t:Text About.License}" MinWidth="112" ToolTip="{t:Text About.License.Tip}" Click="LicenseClicked" />
            <Button Style="{StaticResource GoButton}" Content="{t:Text About.Support}" MinWidth="112" ToolTip="{t:Text About.Support.Tip}" Click="SupportClicked" />
        </controls:SnappedRow>
        <!-- the text scrolls in a sunken box, so its edge shows where it is cut off -->
        <controls:Bevel Margin="0,8,0,0" TopLeft="{DynamicResource lo}" BottomRight="{DynamicResource hi}" Background="{DynamicResource panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl x:Name="Body" Focusable="False" Margin="10,6" />
            </ScrollViewer>
        </controls:Bevel>
    </DockPanel>
</UserControl>
