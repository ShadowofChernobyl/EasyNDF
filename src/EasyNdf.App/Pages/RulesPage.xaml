<!--
  The Rules tab (the HTML app's #pagePresets): on the left the Mod box and the open mod's presets, on the right the open
  preset's rules. Its data is a RulesModel (Rules/RulesModel.cs); RulesPage.xaml.cs asks the questions and passes the
  clicks on to it.
-->
<UserControl x:Class="EasyNdf.App.Pages.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EasyNdf.App.Controls"
             xmlns:theming="clr-namespace:EasyNdf.App.Theming"
             PreviewMouseDown="PageMouseDown">
    <UserControl.Resources>
        <theming:ThemeBrushConverter x:Key="ThemeBrush" />
        <!-- .rows li: a line of a list, 2 by 4 pixels in; selected lines in the selection colour -->
        <Style x:Key="ListLine" TargetType="Border">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource sel}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--
          a line of the rule list: a group's heading on the panel colour with a line under it, as the file list's folder
          lines are (selection, listed after it, still wins)
        -->
        <Style x:Key="RuleLine" TargetType="Border" BasedOn="{StaticResource ListLine}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource panel}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource line}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource sel}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- .rows .name: the line's name, 2 pixels in, on one line, ending in "..." when it does not fit -->
        <Style x:Key="LineName" TargetType="TextBlock">
            <Setter Property="Padding" Value="2" />
            <Setter Property="TextTrimming" Value="{DynamicResource list-trimming}" />
            <Setter Property="TextWrapping" Value="{DynamicResource list-wrapping}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ink}" />
        </Style>
        <!-- .rows: a sunken list; it fills the room its column leaves it, and scrolls -->
        <Style x:Key="SunkenList" TargetType="controls:Bevel">
            <Setter Property="TopLeft" Value="{DynamicResource lo}" />
            <Setter Property="BottomRight" Value="{DynamicResource hi}" />
            <Setter Property="Background" Value="{DynamicResource well}" />
            <Setter Property="MinHeight" Value="96" />
        </Style>
    </UserControl.Resources>

    <!-- the window never scrolls: both lists stretch down to its bottom, their buttons under them -->
    <DockPanel>
        <!-- .cols: 17rem on the left (13rem at the least, in a narrower window), the rest on the right, 14 pixels apart -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the mod and its presets -->
            <DockPanel Grid.Column="0">
                <controls:Bevel DockPanel.Dock="Top" Style="{StaticResource Heading}"><TextBlock Text="Mod" /></controls:Bevel>
                <ComboBox DockPanel.Dock="Top" x:Name="ModChoice" Margin="0,0,0,8" SelectionChanged="ModChosen" ToolTip="Mod" PreviewMouseRightButtonUp="ModBoxRightClicked" />
                <controls:WrapRow DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="New" Click="NewModClicked" ToolTip="New mod" />
                    <Button x:Name="RenameModButton" ToolTip="Rename mod" Content="Rename" Click="RenameModClicked" />
                    <Button x:Name="CopyModButton" ToolTip="Copy this mod and its presets" Content="Make copy" Click="CopyModClicked" />
                    <Button x:Name="DeleteModButton" ToolTip="Delete mod and its presets" Content="Delete" Click="DeleteModClicked" />
                    <Button x:Name="WatermarkButton" Content="Watermark..." ToolTip="This mod's watermark comment" Click="WatermarkClicked" />
                </controls:WrapRow>
                <controls:WrapRow DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Import mod..." Click="ImportModClicked" ToolTip="Load a mod file" />
                    <Button x:Name="ExportModButton" ToolTip="Save mod as a file" Content="Export mod" Click="ExportModClicked" />
                </controls:WrapRow>

                <!-- 4 above, as the row above already leaves 8: the HTML's margins collapse to its 12 -->
                <controls:Bevel DockPanel.Dock="Top" Style="{StaticResource Heading}" Margin="0,4,0,6"><TextBlock Text="{Binding PresetsTitle}" /></controls:Bevel>
                <!-- under the list: its buttons, kept at the column's foot -->
                <controls:WrapRow DockPanel.Dock="Bottom" Margin="0">
                    <Button x:Name="NewPresetButton" ToolTip="New preset" Content="New" Click="NewPresetClicked" />
                    <Button x:Name="RenamePresetButton" ToolTip="Rename preset" Content="Rename" Click="RenamePresetClicked" />
                    <Button x:Name="DuplicatePresetButton" ToolTip="Duplicate selected presets" Content="Duplicate" Click="DuplicatePresetClicked" />
                    <Button x:Name="DeletePresetButton" ToolTip="Delete selected presets (Delete)" Content="Delete" Click="DeletePresetClicked" />
                </controls:WrapRow>
                <controls:Bevel x:Name="PresetBox" Style="{StaticResource SunkenList}" Margin="0,0,0,10" MouseRightButtonUp="PresetListRightClicked">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <TextBlock x:Name="NoPresets" Text="No presets in this mod." Foreground="{DynamicResource muted}" Padding="4,2" />
                            <ItemsControl x:Name="PresetLines" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListLine}" MouseLeftButtonUp="PresetClicked">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding UseText}" Foreground="{DynamicResource muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                <TextBlock x:Name="Name" Style="{StaticResource LineName}" Text="{Binding Name}" />
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- #presetList li.open: the open one is bold while several are selected -->
                                            <DataTrigger Binding="{Binding IsOpenAmongSeveral}" Value="True">
                                                <Setter TargetName="Name" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </controls:Bevel>
            </DockPanel>

            <!-- the open preset's rules -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top">
                    <controls:Bevel Style="{StaticResource Heading}"><TextBlock Text="{Binding RulesTitle}" /></controls:Bevel>
                    <!--
                      the ? at the heading's right, 5 pixels above the heading, clear of the line under it
                      (on purpose: the HTML app's button.qhelp.qf reaches down to the line)
                    -->
                    <Button Style="{StaticResource HelpButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0" controls:QuickHelp.Page="tab-rules" />
                </Grid>
                <!-- under the list, kept at the column's foot: adding rules, what the clipboard did, and the keys (copying, pasting and opening rules are on the right-click menu and the keys) -->
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="0"
                           Text="Double-click a rule to open it. Rules run top to bottom. Ctrl-click or Shift-click selects several, in the preset list too. Ctrl+X, Ctrl+C, Ctrl+V, Ctrl+A and Delete act on the selection; Ctrl+Up and Ctrl+Down move rules." />
                <TextBlock DockPanel.Dock="Bottom" x:Name="ClipNote" Style="{StaticResource Note}" Text="{Binding Note}" Margin="0,0,0,8" />
                <controls:WrapRow DockPanel.Dock="Bottom" Margin="0,0,0,8">
                    <!-- a menu of the rule types, each with its symbol and a line on what it does -->
                    <Button x:Name="NewRuleButton" Content="New rule ▾" ToolTip="Add a rule below the selected one. Ctrl+N adds an Edit rule" Click="NewRuleClicked" />
                </controls:WrapRow>
                <controls:Bevel x:Name="RuleBox" Style="{StaticResource SunkenList}" Margin="0,0,0,10" MouseRightButtonUp="RuleListRightClicked">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <TextBlock x:Name="NoRules" Text="{Binding NoRulesText}" Foreground="{DynamicResource muted}" Padding="4,2" TextWrapping="Wrap" />
                            <ItemsControl x:Name="RuleLines" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Line" Style="{StaticResource RuleLine}" MouseLeftButtonUp="RuleClicked">
                                            <DockPanel>
                                                <!-- ↑ ↓ + ×, 4 pixels apart -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Content="&#x2191;" Tag="up" Margin="4,0,0,0" ToolTip="Move up" Click="RuleButtonClicked" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#x2193;" Tag="down" Margin="4,0,0,0" ToolTip="Move down" Click="RuleButtonClicked" />
                                                    <Button Style="{StaticResource IconButton}" Content="+" Tag="dup" Margin="4,0,0,0" ToolTip="Duplicate" Click="RuleButtonClicked" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xD7;" Tag="del" Margin="4,0,0,0" ToolTip="Delete" Click="RuleButtonClicked" />
                                                </StackPanel>
                                                <Button x:Name="Fold" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="fold" Margin="0,0,4,0"
                                                        Content="&#x25BE;" ToolTip="Hide the rules in this group" Visibility="Collapsed" Click="RuleButtonClicked" />
                                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource Toggle}" IsChecked="{Binding IsOn, Mode=OneWay}" Margin="0,0,4,0"
                                                          ToolTip="Enable rule" Click="RuleSwitchClicked" />
                                                <!-- .ksym: the type's symbol, in its colour; a click opens the rule -->
                                                <!-- the rule's type symbol opens the rule; under the mouse it takes the hover colour, as menus do -->
                                                <Border DockPanel.Dock="Left" Width="18" CornerRadius="3" Margin="0,0,4,0" VerticalAlignment="Center" Cursor="Hand"
                                                        MouseLeftButtonUp="SymbolClicked" ToolTip="{Binding SymbolTip}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource hover}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <TextBlock x:Name="Symbol" TextAlignment="Center" FontSize="13" Padding="0,2" Text="{Binding SymbolText}"
                                                                   Foreground="{Binding SymbolColour, Converter={StaticResource ThemeBrush}}" />
                                                        <!-- a group's symbol: a manila folder's outline (Controls/FolderGlyph.cs) -->
                                                        <controls:FolderGlyph x:Name="Folder" Visibility="Collapsed"
                                                                              Foreground="{Binding SymbolColour, Converter={StaticResource ThemeBrush}}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="Count" DockPanel.Dock="Right" Foreground="{DynamicResource muted}" FontSize="11" VerticalAlignment="Center"
                                                           Margin="4,0,0,0" Visibility="Collapsed" />
                                                <TextBlock x:Name="Name" Style="{StaticResource LineName}" Text="{Binding Name}" />
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- li.in: a rule under a group's heading, 18 pixels in -->
                                            <DataTrigger Binding="{Binding IsInGroup}" Value="True">
                                                <Setter TargetName="Line" Property="Padding" Value="18,2,4,2" />
                                            </DataTrigger>
                                            <!-- li.grp: a group's heading, with its fold button; not bold, like the file list's folder rows -->
                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                <Setter TargetName="Fold" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Symbol" Property="Visibility" Value="Hidden" />
                                                <Setter TargetName="Folder" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFolded}" Value="True">
                                                <Setter TargetName="Fold" Property="Content" Value="&#x25B8;" />
                                                <Setter TargetName="Fold" Property="ToolTip" Value="Show the rules in this group" />
                                                <Setter TargetName="Count" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <!-- li.off: a rule switched off, or in a group that is, has a dim name -->
                                            <DataTrigger Binding="{Binding IsOff}" Value="True">
                                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource muted}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </controls:Bevel>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
