<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EasyNDF</AssemblyName>
    <RootNamespace>EasyNdf.App</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\EasyNDF.ico</ApplicationIcon>
    <!-- lets the app build on Linux too; it only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      Memory is cleaned up on every processor core, not one: the rules run about a third faster on large files
      (UniteDescriptor.ndf: 2.6 to 1.7 seconds to load and export). .NET keeps the extra memory this takes small by
      itself (its "DATAS"), about 350 MB more at the peak on that file.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\EasyNDF.ico" />
    <!-- WARNO Tactical Overhaul, the mod the app comes with: the HTML app's #defaultMod -->
    <EmbeddedResource Include="Assets\DefaultMod.json" LogicalName="DefaultMod.json" />
    <!-- the Help wiki's pages, copied from the HTML app -->
    <!-- the app's English texts, one file per part of the app (see Text\Texts.cs) -->
    <EmbeddedResource Include="Languages\en\*.json" LogicalName="EasyNdf.App.Languages.en.%(Filename)%(Extension)" />
    <!-- the other languages built into the app, one pack file each (fr.json...), made by the translate tool -->
    <EmbeddedResource Include="Languages\*.json" LogicalName="EasyNdf.App.LanguagePacks.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\wiki.json" LogicalName="wiki.json" />
    <!-- the About tab's text, and the license its License button shows -->
    <EmbeddedResource Include="Help\about.html" LogicalName="about.html" />
    <EmbeddedResource Include="Help\changelog.html" LogicalName="changelog.html" />
    <EmbeddedResource Include="..\..\LICENSE.txt" Link="LICENSE.txt" LogicalName="LICENSE.txt" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyNdf.Data\EasyNdf.Data.csproj" />
    <ProjectReference Include="..\EasyNdf.Engine\EasyNdf.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- opens .rar archives (MIT; its notice is in THIRD-PARTY-NOTICES.txt, which ships beside the app) -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

</Project>
