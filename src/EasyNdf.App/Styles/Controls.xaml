<!--
  The look of the app's controls, copied from the HTML app's CSS. Colours come from the theme (see Theming/ThemeManager.cs),
  always through DynamicResource so that a new theme recolours everything at once.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EasyNdf.App.Controls"
                    xmlns:units="clr-namespace:EasyNdf.App.Units">

    <!--
      Emoji in colour: WPF can only draw emoji as plain symbols from Windows' fonts, so the two the app shows are
      Microsoft's Fluent Emoji (flat style, MIT licence, see THIRD-PARTY-NOTICES.txt), copied here from their 32-pixel
      drawings, shape by shape.
    -->
